-- ==================== SETTINGS ====================
local Settings = {
    AutoBreak = false,          -- Tự đập trứng
    AutoSteal = false,          -- Tự bắt pet + kéo về base
    MinIncome = 20000000,       -- Chỉ lấy pet >= 20M/s
    BreakRange = 25,            -- Tầm đập trứng
    StealRange = 40,            -- Tầm bắt pet
    BringToBase = true,         -- Kéo về base
    AntiAFK = true,
}

-- ==================== UTILS ====================
local function getChar()
    local c = lp.Character
    if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChildOfClass("Humanoid") then
        return c, c.HumanoidRootPart, c:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

local function getBase()
    -- Thử tìm base của mình
    local plots = workspace:FindFirstChild("Plots") or workspace:FindFirstChild("Bases") or workspace:FindFirstChild("PlayerPlots")
    if plots then
        for _, p in ipairs(plots:GetChildren()) do
            if p:GetAttribute("Owner") == lp.UserId or p.Name == tostring(lp.UserId) or p:FindFirstChild(lp.Name) then
                return p
            end
        end
    end
    -- Fallback: vị trí spawn
    local _, root = getChar()
    return root and root.Position or Vector3.new(0, 5, 0)
end

local function tweenTo(pos, speed)
    local _, root = getChar()
    if not root then return end
    local dist = (root.Position - pos).Magnitude
    local time = math.clamp(dist / (speed or 60), 0.3, 4)
    local tw = TweenService:Create(root, TweenInfo.new(time, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    })
    tw:Play()
    tw.Completed:Wait()
end

local function fireClick()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)
end

-- ==================== AUTO BREAK EGG ====================
local function findNearestEgg()
    local _, root = getChar()
    if not root then return nil end

    local nearest, dist = nil, Settings.BreakRange
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("egg") or obj:GetAttribute("Egg") or obj:HasTag("Egg") then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local d = (root.Position - pos).Magnitude
                if d < dist then
                    nearest, dist = obj, d
                end
            end
        end
    end
    return nearest
end

local function autoBreak()
    while Settings.AutoBreak do
        local egg = findNearestEgg()
        if egg then
            local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
            tweenTo(pos, 70)
            -- Spam click / swing
            for i = 1, 8 do
                fireClick()
                task.wait(0.12)
            end
        end
        task.wait(0.4)
    end
end

-- ==================== AUTO STEAL PET ====================
local function getPetIncome(pet)
    -- Thử lấy income từ attribute
    local income = pet:GetAttribute("Income") 
        or pet:GetAttribute("MoneyPerSecond") 
        or pet:GetAttribute("CashPerSec")
        or pet:GetAttribute("Value")
    
    if type(income) == "number" then return income end

    -- Thử tìm trong UI / Billboard
    local billboard = pet:FindFirstChildWhichIsA("BillboardGui", true)
    if billboard then
        for _, label in ipairs(billboard:GetDescendants()) do
            if label:IsA("TextLabel") then
                local text = label.Text:lower()
                local num = text:match("([%d%.]+)m") or text:match("([%d%.]+)b") or text:match("([%d%.]+)k")
                if num then
                    local n = tonumber(num)
                    if text:find("b") then return n * 1e9 end
                    if text:find("m") then return n * 1e6 end
                    if text:find("k") then return n * 1e3 end
                    return n
                end
            end
        end
    end
    return 0
end

local function findBestPet()
    local _, root = getChar()
    if not root then return nil end

    local best, bestIncome, bestDist = nil, Settings.MinIncome, Settings.StealRange

    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and (obj.Name:lower():find("pet") or obj:HasTag("Pet") or obj:GetAttribute("Pet")) then
            local income = getPetIncome(obj)
            if income >= Settings.MinIncome then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local d = (root.Position - pos).Magnitude
                if d < bestDist or (income > bestIncome and d < Settings.StealRange * 1.5) then
                    best, bestIncome, bestDist = obj, income, d
                end
            end
        end
    end
    return best, bestIncome
end

local function autoSteal()
    while Settings.AutoSteal do
        local pet, income = findBestPet()
        if pet then
            local pos = pet:IsA("Model") and pet:GetPivot().Position or pet.Position
            tweenTo(pos, 80)

            -- Thử bắt (proximity prompt hoặc click)
            local prompt = pet:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                fireproximityprompt(prompt)
            else
                fireClick()
            end

            task.wait(0.3)

            -- Kéo về base
            if Settings.BringToBase then
                local base = getBase()
                local basePos = typeof(base) == "Instance" and (base:IsA("Model") and base:GetPivot().Position or base.Position) or base
                tweenTo(basePos, 90)
            end
        end
        task.wait(0.6)
    end
end

