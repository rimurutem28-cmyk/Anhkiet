local function makeToggle(text, y, key, cb)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 32)
    btn.Position = UDim2.new(0, 10, 0, y)
    btn.TextColor3 = Color3.fromRGB(230, 230, 240)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.Parent = main
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
    local function paint()
        btn.Text = text .. ": " .. (S[key] and "ON" or "OFF")
        btn.BackgroundColor3 = S[key] and Color3.fromRGB(0, 150, 210) or Color3.fromRGB(30, 32, 42)
    end
    paint()
    btn.MouseButton1Click:Connect(function()
        S[key] = not S[key]
        paint()
        if cb then cb() end
    end)
end

local function makeButton(text, y, bg, fg, onClick)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 32)
    btn.Position = UDim2.new(0, 10, 0, y)
    btn.BackgroundColor3 = bg
    btn.Text = text
    btn.TextColor3 = fg
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.Parent = main
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
    btn.MouseButton1Click:Connect(function()
        local msg = onClick()
        if msg then
            btn.Text = msg
            task.delay(1.2, function() btn.Text = text end)
        end
    end)
end

