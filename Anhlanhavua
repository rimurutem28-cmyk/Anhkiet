--[[
    Kiet Hub - Game Info Dumper (Mobile Friendly)
    Hiện hộp chữ để copy dễ trên điện thoại
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local lp = Players.LocalPlayer
repeat task.wait() until lp

local lines = {}
local function log(str)
    str = tostring(str)
    table.insert(lines, str)
    print(str)
end

log("========== KIET GAME INFO DUMPER ==========")
log("Game: " .. tostring(game.PlaceId) .. " | " .. tostring(game.Name))
log("Player: " .. lp.Name .. " | " .. tostring(lp.UserId))
log("")

log("----- REMOTES -----")
local function scanRemotes(parent, path)
    path = path or parent.Name
    for _, obj in ipairs(parent:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("UnreliableRemoteEvent") then
            log(obj.ClassName .. " | " .. path .. "/" .. obj.Name)
        end
        if #obj:GetChildren() > 0 and not obj:IsA("Player") and not obj:IsA("Workspace") then
            pcall(scanRemotes, obj, path .. "/" .. obj.Name)
        end
    end
end
log("[ReplicatedStorage]")
pcall(scanRemotes, ReplicatedStorage)

log("")
log("----- TAGS -----")
pcall(function()
    local tags = {}
    for _, inst in ipairs(workspace:GetDescendants()) do
        for _, tag in ipairs(CollectionService:GetTags(inst)) do
            tags[tag] = (tags[tag] or 0) + 1
        end
    end
    for tag, count in pairs(tags) do
        log("Tag: " .. tag .. " | " .. count)
    end
end)

log("")
log("----- WORKSPACE -----")
for _, obj in ipairs(workspace:GetChildren()) do
    log(obj.ClassName .. " | " .. obj.Name)
end

log("")
log("----- EGGS -----")
local eggCount = 0
for _, obj in ipairs(workspace:GetDescendants()) do
    local name = obj.Name:lower()
    if (name:find("egg") or obj:GetAttribute("Egg") or obj:HasTag("Egg")) and eggCount < 6 then
        eggCount += 1
        log("Egg: " .. obj:GetFullName())
        for attr, val in pairs(obj:GetAttributes()) do
            log("  " .. attr .. " = " .. tostring(val))
        end
    end
end
log("Eggs sample: " .. eggCount)

log("")
log("----- PETS -----")
local petCount = 0
for _, obj in ipairs(workspace:GetDescendants()) do
    local name = obj.Name:lower()
    if (name:find("pet") or obj:GetAttribute("Pet") or obj:HasTag("Pet")) and petCount < 6 then
        petCount += 1
        log("Pet: " .. obj:GetFullName())
        for attr, val in pairs(obj:GetAttributes()) do
            log("  " .. attr .. " = " .. tostring(val))
        end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text ~= "" and #d.Text < 40 then
                log("  Text: " .. d.Text)
            end
        end
    end
end
log("Pets sample: " .. petCount)

log("")
log("----- TOOLS -----")
if lp.Character then
    for _, v in ipairs(lp.Character:GetChildren()) do
        if v:IsA("Tool") then log("CharTool: " .. v.Name) end
    end
end
if lp:FindFirstChild("Backpack") then
    for _, v in ipairs(lp.Backpack:GetChildren()) do
        log("Backpack: " .. v.Name)
    end
end

log("")
log("----- BASES -----")
for _, name in ipairs({"Plots","Bases","PlayerPlots","Farms","Homes","Tycoons","PlayerBases"}) do
    local f = workspace:FindFirstChild(name)
    if f then
        log("Folder: " .. name)
        for i, p in ipairs(f:GetChildren()) do
            if i <= 4 then
                log("  " .. p.Name)
                for attr, val in pairs(p:GetAttributes()) do
                    log("    " .. attr .. " = " .. tostring(val))
                end
            end
        end
    end
end

log("")
log("========== END DUMP ==========")

-- UI COPY BOX
local gui = Instance.new("ScreenGui")
gui.Name = "KietDumperUI"
gui.ResetOnSpawn = false
gui.Parent = lp:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0.92, 0, 0.75, 0)
frame.Position = UDim2.new(0.04, 0, 0.12, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
frame.BorderSizePixel = 0
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 36)
title.BackgroundTransparency = 1
title.Text = "Bôi đen chữ bên dưới → Copy → Gửi mình"
title.TextColor3 = Color3.fromRGB(0, 200, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 13
title.Parent = frame

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -16, 1, -90)
scroll.Position = UDim2.new(0, 8, 0, 40)
scroll.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 8
scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
scroll.Parent = frame
Instance.new("UICorner", scroll).CornerRadius = UDim.new(0, 8)

local box = Instance.new("TextBox")
box.Size = UDim2.new(1, -10, 0, 800)
box.Position = UDim2.new(0, 5, 0, 5)
box.BackgroundTransparency = 1
box.Text = table.concat(lines, "\n")
box.TextColor3 = Color3.fromRGB(220, 220, 230)
box.Font = Enum.Font.Code
box.TextSize = 11
box.TextXAlignment = Enum.TextXAlignment.Left
box.TextYAlignment = Enum.TextYAlignment.Top
box.TextWrapped = true
box.ClearTextOnFocus = false
box.MultiLine = true
box.Parent = scroll

scroll.CanvasSize = UDim2.new(0, 0, 0, 820)

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(1, -16, 0, 36)
closeBtn.Position = UDim2.new(0, 8, 1, -44)
closeBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 200)
closeBtn.Text = "Đóng"
closeBtn.TextColor3 = Color3.new(1,1,1)
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextSize = 14
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 8)
closeBtn.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

print("[Kiet Dumper] UI hiện - bôi đen rồi Copy")
