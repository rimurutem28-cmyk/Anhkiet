--[[
    Kiet Hub - Slash and Steal Pets
    Fix: Về base sau khi bắt pet + tìm base tốt hơn
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local lp = Players.LocalPlayer
repeat task.wait() until lp

local S = {
    AutoSlash = false,
    AutoSteal = false,
    MinIncome = 20000000,
    SlashRange = 35,
    StealRange = 50,
    BringHome = true,
    Speed = 100,
}

local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

local function tweenTo(pos, speed)
    local root = getRoot()
    if not root or not pos then return end
    local dist = (root.Position - pos).Magnitude
    if dist < 5 then return end
    local t = math.clamp(dist / (speed or S.Speed), 0.2, 4)
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
    })
    tw:Play()
    tw.Completed:Wait()
end

local function spamClick(n)
    for i = 1, (n or 8) do
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            task.wait(0.035)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end)
        task.wait(0.06)
    end
end

local function firePrompts(obj)
    if not obj then return end
    for _, v in ipairs(obj:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            pcall(fireproximityprompt, v)
        end
    end
end

-- ==================== TÌM BASE ====================
local savedHome = nil

local function findHome()
    if savedHome then return savedHome end

    local candidates = {}

    -- Cách 1: Tìm theo Owner
    for _, folderName in ipairs({"Plots", "Bases", "PlayerPlots", "Farms", "Homes", "Tycoons", "PlayerBases"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            for _, p in ipairs(folder:GetChildren()) do
                local owner = p:GetAttribute("Owner") or p:GetAttribute("OwnerId") or p:GetAttribute("Player")
                if owner == lp.UserId or owner == lp.Name or p.Name == tostring(lp.UserId) or p.Name == lp.Name then
                    local pos = p:IsA("Model") and p:GetPivot().Position or (p:IsA("BasePart") and p.Position)
                    if pos then
                        savedHome = pos
                        return pos
                    end
                end
            end
        end
    end

    -- Cách 2: Tìm SpawnLocation gần nhất của mình
    for _, sp in ipairs(workspace:GetDescendants()) do
        if sp:IsA("SpawnLocation") then
            local pos = sp.Position
            table.insert(candidates, pos)
        end
    end

    -- Cách 3: Dùng vị trí hiện tại làm home tạm (lần đầu)
    local root = getRoot()
    if root then
        savedHome = root.Position
        return savedHome
    end

    return Vector3.new(0, 10, 0)
end

-- Nút "Set Home" để người chơi đứng ở base rồi lưu
local function setHomeHere()
    local root = getRoot()
    if root then
        savedHome = root.Position
        return true
    end
    return false
end

-- ==================== EGG ====================
local function findNearestEgg()
    local root = getRoot()
    if not root then return nil end
    local nearest, minD = nil, S.SlashRange
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("egg") or obj:GetAttribute("Egg") or obj:HasTag("Egg") then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local d = (root.Position - pos).Magnitude
                if d < minD then
                    nearest, minD = obj, d
                end
            end
        end
    end
    return nearest
end

-- ==================== PET ====================
local function parseIncome(text)
    if not text then return 0 end
    text = tostring(text):lower():gsub(",", ""):gsub("%$", ""):gsub("%s", "")
    local num, suf = text:match("([%d%.]+)([kmb]?)")
    if not num then return 0 end
    num = tonumber(num) or 0
    if suf == "k" then return num * 1e3 end
    if suf == "m" then return num * 1e6 end
    if suf == "b" then return num * 1e9 end
    return num
end

local function getIncome(obj)
    for _, a in ipairs({"Income", "MoneyPerSecond", "Value", "MPS", "Earnings", "Gen", "Money", "CashPerSec"}) do
        local v = obj:GetAttribute(a)
        if type(v) == "number" and v > 0 then return v end
        if type(v) == "string" then
            local n = parseIncome(v)
            if n > 0 then return n end
        end
    end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local n = parseIncome(d.Text)
            if n >= S.MinIncome then return n end
        end
    end
    return 0
end

local function findBestPet()
    local root = getRoot()
    if not root then return nil end
    local best, bestInc, bestD = nil, S.MinIncome - 1, S.StealRange
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("pet") or obj:GetAttribute("Pet") or obj:HasTag("Pet") or getIncome(obj) > 0 then
                local inc = getIncome(obj)
                if inc >= S.MinIncome then
                    local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                    local d = (root.Position - pos).Magnitude
                    if d < bestD or (inc > bestInc and d < S.StealRange * 2) then
                        best, bestInc, bestD = obj, inc, d
                    end
                end
            end
        end
    end
    return best, bestInc
end

-- ==================== LOOPS ====================
local function autoSlashLoop()
    while S.AutoSlash do
        local egg = findNearestEgg()
        if egg then
            local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
            tweenTo(pos, S.Speed)
            spamClick(12)
            firePrompts(egg)
            local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
        end
        task.wait(0.3)
    end
end

local function autoStealLoop()
    while S.AutoSteal do
        local pet = findBestPet()
        if pet then
            local pos = pet:IsA("Model") and pet:GetPivot().Position or pet.Position
            tweenTo(pos, S.Speed + 15)
            firePrompts(pet)
            spamClick(5)

            -- Thử bắt
            local prompt = pet:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then pcall(fireproximityprompt, prompt) end

            task.wait(0.35)

            -- ===== VỀ BASE NGAY =====
            if S.BringHome then
                local home = findHome()
                if home then
                    -- Bay về mạnh
                    tweenTo(home, S.Speed + 30)
                    task.wait(0.2)
                    -- Thử đặt pet
                    firePrompts(workspace)
                end
            end
        end
        task.wait(0.45)
    end
end

