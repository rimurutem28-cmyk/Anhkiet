local lp = Players.LocalPlayer
repeat task.wait() until lp

local S = {
    AutoSlash = false,
    AutoSteal = false,
    MinIncome = 20000000,
    BringHome = true,
    Speed = 55,
    ReturnSpeed = 40,
}

local savedHome = nil
local savedEndMap = nil

local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

local function tweenTo(pos, speed)
    local root = getRoot()
    if not root or not pos then return end
    local dist = (root.Position - pos).Magnitude
    if dist < 8 then return end
    local t = math.clamp(dist / (speed or S.Speed), 0.4, 7)
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    })
    tw:Play()
    tw.Completed:Wait()
end

local function spamClick(n)
    for i = 1, (n or 10) do
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            task.wait(0.03)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end)
        task.wait(0.05)
    end
end

local function firePrompts(obj)
    if not obj then return end
    pcall(function()
        for _, v in ipairs(obj:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                fireproximityprompt(v)
            end
        end
    end)
end

local function setHomeHere()
    local root = getRoot()
    if root then savedHome = root.Position return true end
    return false
end

local function setEndMapHere()
    local root = getRoot()
    if root then savedEndMap = root.Position return true end
    return false
end

local function getHomePos()
    if savedHome then return savedHome end
    local root = getRoot()
    return root and root.Position or Vector3.new(0, 10, 0)
end

local function findWorldEgg()
    local root = getRoot()
    if not root then return nil end
    local best, bestD = nil, 120
    for _, egg in ipairs(CollectionService:GetTagged("SAE_WorldEgg")) do
        if egg:IsDescendantOf(workspace) then
            local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
            local d = (root.Position - pos).Magnitude
            if d < bestD then
                best, bestD = egg, d
            end
        end
    end
    return best
end

local function parseIncome(t)
    if not t then return 0 end
    t = tostring(t):lower():gsub(",",""):gsub("%$",""):gsub("%s","")
    local n, s = t:match("([%d%.]+)([kmb]?)")
    if not n then return 0 end
    n = tonumber(n) or 0
    if s == "k" then return n*1e3 end
    if s == "m" then return n*1e6 end
    if s == "b" then return n*1e9 end
    return n
end

local function getIncome(obj)
    local v = obj:GetAttribute("Income")
    if type(v) == "number" and v > 0 then return v end
    for _, a in ipairs({"MoneyPerSecond","Value","MPS","IncomeBeforeDiv10"}) do
        local x = obj:GetAttribute(a)
        if type(x) == "number" and x > 0 then return x end
    end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text ~= "" then
            local n = parseIncome(d.Text)
            if n >= 1000 then return n end
        end
    end
    return 0
end

local function findBestPet()
    local root = getRoot()
    if not root then return nil end
    local best, bestInc, bestD = nil, 0, 80
    for _, pet in ipairs(CollectionService:GetTagged("SAE_PenRoam")) do
        local inc = getIncome(pet)
        if inc >= S.MinIncome then
            local pos = pet:IsA("Model") and pet:GetPivot().Position or pet.Position
            local d = (root.Position - pos).Magnitude
            if d < bestD or inc > bestInc then
                best, bestInc, bestD = pet, inc, d
            end
        end
    end
    if not best then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") then
                local inc = getIncome(obj)
                if inc >= S.MinIncome then
                    local pos = obj:GetPivot().Position
                    local d = (root.Position - pos).Magnitude
                    if d < 80 and (d < bestD or inc > bestInc) then
                        best, bestInc, bestD = obj, inc, d
                    end
                end
            end
        end
    end
    return best
end

local function autoSlashLoop()
    while S.AutoSlash do
        if savedEndMap then
            local root = getRoot()
            if root and (root.Position - savedEndMap).Magnitude > 45 then
                tweenTo(savedEndMap, S.Speed)
            end
        end
        local egg = findWorldEgg()
        if egg then
            local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
            tweenTo(pos, S.Speed)
            spamClick(15)
            firePrompts(egg)
            local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
        end
        task.wait(0.3)
    end
end

local function autoStealLoop()
    while S.AutoSteal do
        local pet = findBestPet()
        if pet then
            local pos = pet:IsA("Model") and pet:GetPivot().Position or pet.Position
            tweenTo(pos, S.Speed + 5)
            task.wait(0.2)
            firePrompts(pet)
            spamClick(8)
            local prompt = pet:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then pcall(fireproximityprompt, prompt) end
            task.wait(0.6)
            if S.BringHome then
                local home = getHomePos()
                tweenTo(home, S.ReturnSpeed)
                task.wait(0.4)
                firePrompts(workspace)
            end
        else
            task.wait(0.7)
        end
        task.wait(0.35)
    end
end

