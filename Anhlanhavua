--[[
    Kiet Hub V6 - Slash and Steal Pets (Auto Carry Detection & Multi-Interact)
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer

repeat task.wait() until lp

local S = {
    AutoSlash = false,
    AutoSteal = false,
    BringHome = true,
    Speed = 34,
    ReturnSpeed = 28,
}

local savedHome = nil
local savedEndMap = nil
local isReturning = false
local noclipConnection = nil

local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

-- Tắt va chạm map khi di chuyển về base
local function enableNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if lp.Character then
                    for _, v in ipairs(lp.Character:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

local function safeMoveTo(pos, speed)
    local root = getRoot()
    if not root or not pos then return end
    
    local dist = (root.Position - pos).Magnitude
    if dist < 4 then return end
    
    enableNoclip(true)
    
    local spd = speed or S.Speed
    local t = dist / spd
    
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
    })
    
    tw:Play()
    
    local elapsedTime = 0
    while elapsedTime < t do
        if not getRoot() then tw:Cancel() break end
        task.wait(0.05)
        elapsedTime = elapsedTime + 0.05
    end
    
    enableNoclip(false)
    task.wait(0.2)
end

-- KIỂM TRA XEM NHÂN VẬT CÓ ĐANG CẦM/MANG PET KHÔNG
local function isCarryingPet()
    local char = lp.Character
    if not char then return false end
    
    -- 1. Kiểm tra Tool đang cầm trên tay hoặc trong Backpack
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("pet") or item.Name:lower():find("egg") or item:GetAttribute("Pet")) then
            return true
        end
    end
    
    -- 2. Kiểm tra Pet dính trên người (Model/Weld)
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Model") or child:IsA("BasePart") then
            local n = child.Name:lower()
            if n:find("pet") or child:GetAttribute("Carrying") or child:GetAttribute("Pet") then
                return true
            end
        end
    end
    
    -- 3. Kiểm tra Attribute trạng thái
    if char:GetAttribute("Carrying") or char:GetAttribute("HasPet") or lp:GetAttribute("Carrying") then
        return true
    end
    
    return false
end

-- TƯƠNG TÁC ĐA NĂNG (Gồm Prompt + Chạm Hitbox TouchInterest)
local function interactPet(obj)
    if not obj then return end
    
    -- 1. Kích hoạt ProximityPrompt
    for _, prompt in ipairs(obj:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function()
                local oldHold = prompt.HoldDuration
                prompt.HoldDuration = 0
                fireproximityprompt(prompt)
                prompt.HoldDuration = oldHold
            end)
        end
    end
    
    -- 2. Chạm trực tiếp Hitbox (Dành cho game nhận TouchInterest)
    local root = getRoot()
    if root then
        for _, part in ipairs(obj:GetDescendants()) do
            if part:IsA("BasePart") and part:FindFirstChildOfClass("TouchTransmitter") then
                pcall(function()
                    firetouchinterest(root, part, 0)
                    task.wait(0.05)
                    firetouchinterest(root, part, 1)
                end)
            end
        end
    end
end

-- TÌM PET GẦN NHẤT HOẶC TRÊN BẢN ĐỒ
local function findPetObject()
    local root = getRoot()
    if not root then return nil end
    
    local bestObj = nil
    local shortestDist = math.huge
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
            local hasTouch = obj:FindFirstChildWhichIsA("TouchTransmitter", true) ~= nil
            
            if (name:find("pet") or obj:GetAttribute("Pet") or hasPrompt or hasTouch) and not obj:IsDescendantOf(lp.Character) then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local dist = (root.Position - pos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    bestObj = obj
                end
            end
        end
    end
    return bestObj
end

-- VÒNG LẶP KIỂM TRA LẤY PET & VÀO BASE (LIÊN TỤC 0.1s)
task.spawn(function()
    while true do
        task.wait(0.1)
        
        -- A. NẾU PHÁT HIỆN ĐANG MANG PET (TỰ BẮT HOẶC AUTO BẮT) -> CHẠY NGAY VỀ BASE
        if S.BringHome and savedHome and isCarryingPet() and not isReturning then
            isReturning = true
            print("[Kiet Hub] Đã phát hiện Pet trên người! Đang quay về Base...")
            safeMoveTo(savedHome, S.ReturnSpeed)
            task.wait(0.8) -- Đợi Base nhận Pet
            isReturning = false
        end
        
        -- B. AUTO BẮT PET
        if S.AutoSteal and not isReturning and not isCarryingPet() then
            local pet = findPetObject()
            if pet then
                local pos = pet:IsA("Model") and pet:GetPivot().Position or pet.Position
                
                -- Bay lại gần Pet
                safeMoveTo(pos, S.Speed)
                task.wait(0.1)
                
                -- Thực hiện nhặt/bắt Pet
                interactPet(pet)
                task.wait(0.3)
            end
        end
        
        -- C. AUTO SLASH TRỨNG
        if S.AutoSlash and not isReturning and not isCarryingPet() then
            if savedEndMap then
                local root = getRoot()
                if root and (root.Position - savedEndMap).Magnitude > 15 then
                    safeMoveTo(savedEndMap, S.Speed)
                end
            end
            
            -- Tự dùng Tool chém
            local char = lp.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if not tool then
                local backpack = lp:FindFirstChild("Backpack")
                if backpack then
                    tool = backpack:FindFirstChildOfClass("Tool")
                    if tool then tool.Parent = char end
                end
            end
            if tool then pcall(function() tool:Activate() end) end
        end
    end
end)

