-- Dragging GUI
local isDragging, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
MainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- VÒNG LẶP XỬ LÝ
task.spawn(function()
    while true do
        task.wait(0.1)

        -- 1. AUTO STEAL PET (CHỈ VỀ BASE SAU KHI BẮT THÀNH CÔNG)
        if Config.AutoSteal and not IsProcessing then
            local targetPet = FindPet()
            if targetPet then
                IsProcessing = true
                local targetPos = targetPet:IsA("Model") and targetPet:GetPivot().Position or targetPet.Position
                
                -- Teleport lại gần Pet
                Teleport(targetPos)
                task.wait(0.1)
                
                -- Thực hiện nhặt/bắt Pet
                local success = TriggerInteraction(targetPet)
                task.wait(0.3)
                
                -- CHỈ KHI BẬT AutoReturn VÀ ĐÃ LƯU SavedHome VÀ BẮT PET THÀNH CÔNG MỚI BAY VỀ BASE!
                if Config.AutoReturn and SavedHome and success then
                    Teleport(SavedHome)
                    task.wait(0.5)
                end
                
                IsProcessing = false
            end
        end

        -- 2. AUTO SLASH EGG
        if Config.AutoSlash and not IsProcessing then
            if SavedEndMap then
                local _, hrp = GetCharacter()
                if hrp and (hrp.Position - SavedEndMap).Magnitude > 12 then
                    Teleport(SavedEndMap)
                end
            end

            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then
                    local backpack = LocalPlayer:FindFirstChild("Backpack")
                    if backpack then
                        tool = backpack:FindFirstChildOfClass("Tool")
                        if tool then tool.Parent = char end
                    end
                end
                if tool then pcall(function() tool:Activate() end) end
            end
        end
    end
end)

