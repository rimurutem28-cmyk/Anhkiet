-- Lưu / tải setting + vị trí Home, Map cuối (file theo PlaceId, cần executor có writefile/readfile)
----------------------------------------------------------------
local SAVE_FILE = "KietHub_" .. tostring(game.PlaceId) .. ".json"
local SAVE_KEYS = { "ViaHome", "AutoSlash", "AutoSteal", "AutoBoss", "BossStay", "BringHome", "MinIncome", "MinEggHP", "EggKeyword", "Speed", "ReturnSpeed", "Move", "TeleStep", "Path" }
local saveQueued = false

local function vecToTable(v)
    return v and { v.X, v.Y, v.Z } or nil
end

local function saveSettings()
    if not writefile then return end
    local data = { S = {}, home = vecToTable(savedHome), endMap = vecToTable(savedEndMap) }
    for _, k in ipairs(SAVE_KEYS) do data.S[k] = S[k] end
    data.spots = {}
    for _, sp in ipairs(eggSpots) do
        data.spots[#data.spots + 1] = { math.floor(sp.X), math.floor(sp.Y), math.floor(sp.Z) }
    end
    local ok, err = pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
    if not ok then log("Lưu setting lỗi: " .. tostring(err)) end
end

local function queueSave()
    if saveQueued then return end
    saveQueued = true
    task.delay(0.5, function()
        saveQueued = false
        saveSettings()
    end)
end

local function loadSettings()
    if not (readfile and isfile) then return false end
    local ok, data = pcall(function()
        if not isfile(SAVE_FILE) then return nil end
        return HttpService:JSONDecode(readfile(SAVE_FILE))
    end)
    if not ok or type(data) ~= "table" then return false end
    if type(data.S) == "table" then
        for _, k in ipairs(SAVE_KEYS) do
            local v = data.S[k]
            if v ~= nil and type(v) == type(S[k]) then S[k] = v end
        end
    end
    if S.Move ~= "walk" and S.Move ~= "tween" and S.Move ~= "tele" then S.Move = "walk" end
    if S.Path ~= "vertical" and S.Path ~= "horizontal" and S.Path ~= "straight" then S.Path = "vertical" end
    local function toVec(t)
        if type(t) == "table" and #t == 3 then return Vector3.new(t[1], t[2], t[3]) end
    end
    savedHome = toVec(data.home) or savedHome
    savedEndMap = toVec(data.endMap) or savedEndMap
    if type(data.spots) == "table" then
        for _, t in ipairs(data.spots) do
            local v = toVec(t)
            if v and #eggSpots < 300 and not eggSpotSet[spotKey(v)] then
                eggSpotSet[spotKey(v)] = true
                eggSpots[#eggSpots + 1] = v
            end
        end
    end
    return true
end

local loadedSettings = loadSettings()

