--[[
    Kiet Hub - Slash and Steal Pets (Fix Delay & Fix Base Event Spam)
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer

repeat task.wait() until lp

local S = {
    AutoSlash = false,
    AutoSteal = false,
    MinIncome = 20000000,
    SlashRange = 120,
    StealRange = 100,
    BringHome = true,
    Speed = 45,       -- Hạ tốc độ di chuyển để tránh bị rubberband (giật lùi)
    ReturnSpeed = 35, -- Tốc độ về base an toàn
}

local savedHome = nil
local savedEndMap = nil
local isBusy = false

local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

-- Tween mượt hơn, hạn chế bị giật lùi về vị trí cũ
local function tweenTo(pos, speed)
    local root = getRoot()
    if not root or not pos then return end
    
    local dist = (root.Position - pos).Magnitude
    if dist < 6 then return end
    
    local spd = speed or S.Speed
    local t = math.clamp(dist / spd, 0.3, 10)
    
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
    })
    
    tw:Play()
    
    local elapsedTime = 0
    while elapsedTime < t do
        if not getRoot() then tw:Cancel() break end
        task.wait(0.05)
        elapsedTime = elapsedTime + 0.05
    end
    
    task.wait(0.15) -- Dừng nghỉ ngắn để Server cập nhật vị trí chính xác
end

-- Chỉ Kích Hoạt Prompt Được Chỉ Định (Không bấm linh tinh ở Base)
local function interactObject(obj)
    if not obj then return end
    pcall(function()
        for _, v in ipairs(obj:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                fireproximityprompt(v)
            end
        end
    end)
end

local function setHomeHere()
    local root = getRoot()
    if root then savedHome = root.Position return true end
    return false
end

local function setEndMapHere()
    local root = getRoot()
    if root then savedEndMap = root.Position return true end
    return false
end

local function getHome()
    return savedHome or (getRoot() and getRoot().Position)
end

local function parseIncome(t)
    if not t then return 0 end
    t = tostring(t):lower():gsub(",",""):gsub("%$",""):gsub("%s","")
    local n, s = t:match("([%d%.]+)([kmb]?)")
    if not n then return 0 end
    n = tonumber(n) or 0
    if s == "k" then return n*1e3 end
    if s == "m" then return n*1e6 end
    if s == "b" then return n*1e9 end
    return n
end

local function getIncome(obj)
    for _, a in ipairs({"Income","MoneyPerSecond","Value","MPS","Earnings","Gen","Money"}) do
        local v = obj:GetAttribute(a)
        if type(v) == "number" and v > 0 then return v end
        if type(v) == "string" then
            local n = parseIncome(v)
            if n > 0 then return n end
        end
    end
    return 0
end

local function findEgg()
    local root = getRoot()
    if not root then return nil end
    local best, bestD = nil, S.SlashRange
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("egg") or obj:GetAttribute("Egg") or obj:HasTag("Egg") then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local d = (root.Position - pos).Magnitude
                if d < bestD then
                    best, bestD = obj, d
                end
            end
        end
    end
    return best
end

local function findPet()
    local root = getRoot()
    if not root then return nil end
    local best, bestInc, bestD = nil, 0, S.StealRange
    
    -- Ưu tiên tìm trong Folder Pets nếu có, nếu không thì quét Workspace
    local container = workspace:FindFirstChild("Pets") or workspace:FindFirstChild("DroppedPets") or workspace
    
    for _, obj in ipairs(container:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local inc = getIncome(obj)
            local name = obj.Name:lower()
            if (name:find("pet") or obj:GetAttribute("Pet") or obj:HasTag("Pet") or inc > 0) and inc >= S.MinIncome then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local d = (root.Position - pos).Magnitude
                if d < bestD or (inc > bestInc and d < S.StealRange) then
                    best, bestInc, bestD = obj, inc, d
                end
            end
        end
    end
    return best
end

-- Vòng lặp chính xử lý mượt mà
task.spawn(function()
    while true do
        task.wait(0.2)
        
        -- 1. ƯU TIÊN BẮT PET (AUTO STEAL)
        if S.AutoSteal and not isBusy then
            local pet = findPet()
            if pet then
                isBusy = true
                local pos = pet:IsA("Model") and pet:GetPivot().Position or pet.Position
                
                -- Di chuyển đến Pet
                tweenTo(pos, S.Speed)
                task.wait(0.2)
                
                -- Chỉ kích hoạt Prompt của PET ĐÓ (không bị click nhầm event ở base)
                interactObject(pet)
                task.wait(0.3)
                
                -- Mang về Base nếu bật BringHome
                if S.BringHome then
                    local home = getHome()
                    if home then
                        tweenTo(home, S.ReturnSpeed)
                        task.wait(0.5) -- Nghỉ ở base để server chốt vị trí thành công
                    end
                end
                isBusy = false
            end
        end
        
        -- 2. TỰ ĐỘNG CHÉM TRỨNG (AUTO SLASH EGG)
        if S.AutoSlash and not isBusy then
            if savedEndMap then
                local root = getRoot()
                if root and (root.Position - savedEndMap).Magnitude > 25 then
                    tweenTo(savedEndMap, S.Speed)
                    task.wait(0.2)
                end
            end
            
            local egg = findEgg()
            if egg then
                local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
                tweenTo(pos, S.Speed)
                interactObject(egg)
                
                local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
            end
        end
    end
end)

