local function GetCharacter()

    local character = Player.Character

    if not character then

        return nil, nil, nil

    end

    local root = character:FindFirstChild("HumanoidRootPart")

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid or humanoid.Health <= 0 then

        return nil, nil, nil

    end

    return character, root, humanoid

end

local function SetStatus(message)

    State.Status = message

end

local function SavePosition(which)

    local _, root = GetCharacter()

    if not root then

        SetStatus("Character unavailable")

        return false

    end

    if which == "Home" then

        State.SavedHome = root.CFrame

        SetStatus("Base position saved")

    elseif which == "Map" then

        State.SavedMap = root.CFrame

        SetStatus("Map position saved")

    end

    return true

end

-- Client-side position request; the server may reject it.

local function TeleportToSaved(which)

    if State.Busy then

        SetStatus("Another action is running")

        return

    end

    local destination

    if which == "Home" then

        destination = State.SavedHome

    elseif which == "Map" then

        destination = State.SavedMap

    end

    if typeof(destination) ~= "CFrame" then

        SetStatus("Save this position first")

        return

    end

    local _, root = GetCharacter()

    if not root then

        SetStatus("Character unavailable")

        return

    end

    State.Busy = true

    local success, err = pcall(function()

        local _, currentRoot = GetCharacter()

        if not currentRoot then

            error("Character changed")

        end

        currentRoot.CFrame =

            destination + Vector3.new(0, 3, 0)

    end)

    State.Busy = false

    if success then

        SetStatus("Movement requested")

    else

        SetStatus("Movement failed")

        warn("[KietHub] Teleport error:", err)

    end

end

