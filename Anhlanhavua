local function isWeapon(t)
    return t:IsA("Tool") and not t.Name:find("/s") and t.Name ~= "Trap"
end

local function equipWeapon()
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local held = char:FindFirstChildOfClass("Tool")
    if held and isWeapon(held) then return held end
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if isWeapon(t) then
                hum:EquipTool(t)
                task.wait(0.2)
                return t
            end
        end
    end
    return nil
end

local eventCache = { t = 0, list = {} }
local eggScan = { t = 0, list = {} }

local function rememberSpot(pos)
    local key = spotKey(pos)
    if eggSpotSet[key] or #eggSpots >= 300 then return end
    eggSpotSet[key] = true
    eggSpots[#eggSpots + 1] = pos
    queueSave()
end

local function eggCandidates()
    local seen, list = {}, {}
    local function add(m)
        if m and not seen[m] and (m:IsA("Model") or m:IsA("BasePart"))
            and type(m:GetAttribute("SAE_EggHP")) == "number" then
            seen[m] = true
            list[#list + 1] = m
            local sp = getPos(m)
            if sp then rememberSpot(sp) end
        end
    end
    for _, m in ipairs(CollectionService:GetTagged("SAE_WorldEgg")) do add(m) end
    local world = workspace:FindFirstChild("SAE_World")
    if world then
        for _, m in ipairs(world:GetChildren()) do add(m) end
    end
    -- khu sự kiện: quét lại mỗi 5s cho nhẹ
    local hz = workspace:FindFirstChild("HalloweenZone")
    if hz then
        if os.clock() - eventCache.t > 5 then
            eventCache.t = os.clock()
            eventCache.list = {}
            for _, m in ipairs(hz:GetDescendants()) do
                if (m:IsA("Model") or m:IsA("BasePart")) and type(m:GetAttribute("SAE_EggHP")) == "number" then
                    eventCache.list[#eventCache.list + 1] = m
                end
            end
        end
        for _, m in ipairs(eventCache.list) do add(m) end
    end
    for _, m in ipairs(eggScan.list) do add(m) end
    return list
end

local function pickEgg(list, root, kw, now)
    local bestKey, bestKeyD = nil, math.huge
    local bestNear, bestNearD = nil, math.huge
    local bestEnd, bestEndD = nil, math.huge
    for _, egg in ipairs(list) do
        local hp = egg:GetAttribute("SAE_EggHP")
        if type(hp) == "number" and hp > 0 and egg:IsDescendantOf(workspace)
            and not (badEgg[egg] and now - badEgg[egg] < 60) then
            local maxhp = egg:GetAttribute("SAE_EggMaxHP")
            local size = math.max(hp, type(maxhp) == "number" and maxhp or 0)
            local pos = getPos(egg)
            if pos and size >= S.MinEggHP then
                local d = (root.Position - pos).Magnitude
                if d < bestNearD then bestNear, bestNearD = egg, d end
                if savedEndMap and (pos - savedEndMap).Magnitude <= 150 and d < bestEndD then
                    bestEnd, bestEndD = egg, d
                end
                if kw ~= "" then
                    local text = (tostring(egg:GetAttribute("SAE_EggName") or "") .. " "
                        .. tostring(egg:GetAttribute("Design") or "") .. " "
                        .. tostring(egg:GetAttribute("SourceName") or "") .. " "
                        .. egg:GetFullName()):lower()
                    if text:find(kw, 1, true) and d < bestKeyD then bestKey, bestKeyD = egg, d end
                end
            end
        end
    end
    return bestKey, bestEnd, bestNear
end

local sweep = { t = 0, running = false, idx = 0 }

-- Điểm để server stream map xa: dọc đường Home -> Map cuối mỗi 400 stud, rồi tới các vị trí egg đã nhớ
local function sweepPoints()
    local pts = {}
    if savedHome and savedEndMap then
        local dvec = savedEndMap - savedHome
        local len = dvec.Magnitude
        if len > 1 then
            for t = 0, len, 400 do pts[#pts + 1] = savedHome + dvec.Unit * t end
        end
    end
    for _, sp in ipairs(eggSpots) do pts[#pts + 1] = sp end
    return pts
end

local function startSweep(kw, check, interval)
    if sweep.running or os.clock() - sweep.t < interval then return end
    sweep.t = os.clock()
    sweep.running = true
    task.spawn(function()
        local pts = sweepPoints()
        if #pts > 0 then
            log(("Quét streaming để tìm egg%s (%d điểm)"):format(kw ~= "" and (" '" .. kw .. "'") or "", #pts))
            for i = 1, math.min(14, #pts) do
                if not alive or not (S.AutoSlash or S.AutoSteal or S.AutoBoss) then break end
                local p = pts[(sweep.idx + i - 1) % #pts + 1]
                pcall(function() lp:RequestStreamAroundAsync(p, 2) end)
                if check() then break end
            end
            sweep.idx = (sweep.idx + 14) % #pts
        end
        sweep.running = false
    end)
end

local function findEgg()
    local root = getRoot()
    if not root then return nil end
    local kw = S.EggKeyword:lower()
    local now = os.clock()
    local k, e, n = pickEgg(eggCandidates(), root, kw, now)

    -- có từ khoá mà chưa thấy egg khớp: quét sâu cả workspace (30s/lần) để tìm trứng ngoài danh sách thường
    if kw ~= "" and not k and now - eggScan.t > 30 then
        eggScan.t = now
        local found = {}
        for _, m in ipairs(workspace:GetDescendants()) do
            if (m:IsA("Model") or m:IsA("BasePart")) and type(m:GetAttribute("SAE_EggHP")) == "number" then
                found[#found + 1] = m
            end
        end
        eggScan.list = found
        k, e, n = pickEgg(eggCandidates(), root, kw, now)
        if k then
            log(("Quét toàn map: thấy egg khớp '%s' (%d egg)"):format(kw, #found))
        else
            log(("Chưa thấy egg khớp '%s' (đang tải %d egg, Streaming=%s)"):format(kw, #found, tostring(workspace.StreamingEnabled)))
        end
    end

    -- Streaming bật: egg ở map xa chưa được tải -> nhờ server stream quanh đường Home -> Map cuối (chạy nền, không chặn farm)
    if workspace.StreamingEnabled then
        local nothing = not (k or e or n)
        if nothing or (kw ~= "" and not k) then
            startSweep(kw, function()
                local r = getRoot()
                if not r then return false end
                local kk, ee, nn = pickEgg(eggCandidates(), r, kw, os.clock())
                if kw ~= "" then return kk ~= nil end
                return (kk or ee or nn) ~= nil
            end, nothing and 30 or 120)
        end
    end
    return k or e or n
end

local function nearestEggTo(pos, r)
    local best, bd = nil, r
    for _, m in ipairs(eggCandidates()) do
        local hp = m:GetAttribute("SAE_EggHP")
        local p = getPos(m)
        if type(hp) == "number" and hp > 0 and p and m:IsDescendantOf(workspace) then
            local dist = (p - pos).Magnitude
            if dist < bd then best, bd = m, dist end
        end
    end
    return best
end

local function slashOnce()
    local root = getRoot()
    if not root then return end
    local egg = findEgg()
    if not egg then
        setStatus("Chờ egg" .. (S.MinEggHP > 0 and (" >= " .. fmtNum(S.MinEggHP) .. " máu") or ""))
        if savedEndMap and (root.Position - savedEndMap).Magnitude > 45 then
            travelTo(savedEndMap, S.Speed)
        end
        return
    end
    local tool = equipWeapon()
    if not tool then
        setStatus("Không có vũ khí trong túi")
        return
    end
    setStatus("Đang chém egg")
    local targetPos = getPos(egg)
    travelTo(targetPos, S.Speed)
    -- đi xa thì egg có thể bị stream out/in (instance đổi): tìm lại egg gần đích
    if not egg:IsDescendantOf(workspace) then
        egg = nearestEggTo(targetPos, 80)
        if not egg then return end
    end
    do
        local r, ep = getRoot(), getPos(egg)
        if r and ep and S.AutoSlash and os.clock() - resetInfo.at > 5
            and (flat(r.Position) - flat(ep)).Magnitude > 25 then
            badEgg[egg] = os.clock()
            log("Không tới được egg (có thể khác map), bỏ qua 60s: " .. tostring(egg:GetAttribute("SAE_EggName") or egg.Name))
            return
        end
    end
    local n = 0
    while alive and S.AutoSlash and n < 40 and getRoot()
        and egg:IsDescendantOf(workspace)
        and (egg:GetAttribute("SAE_EggHP") or 0) > 0 do
        pcall(function() tool:Activate() end)
        n += 1
        task.wait(0.15)
    end
    if not egg:IsDescendantOf(workspace) or (egg:GetAttribute("SAE_EggHP") or 0) <= 0 then
        stats.eggs += 1
        updateStats()
    end
end

