local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

local function getPos(inst)
    if not inst then return nil end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    return nil
end

local function tweenDirect(pos, speed)
    local root = getRoot()
    if not root or not pos or not alive then return end
    local dist = (root.Position - pos).Magnitude
    if dist < 8 then return end
    local t = math.max(dist / (speed or S.Speed), 0.15)
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)),
    })
    curTween = tw
    local done = false
    local c = tw.Completed:Connect(function() done = true end)
    tw:Play()
    local t0 = os.clock()
    -- chờ xong, nhưng thoát nếu nhân vật bị thay (respawn/reset), boss bật, hoặc quá giờ
    while not done and alive and os.clock() - t0 < t + 1.5 do
        if getRoot() ~= root then break end
        if hooks.interrupt and hooks.interrupt() then break end
        task.wait(0.1)
    end
    c:Disconnect()
    if not done then tw:Cancel() end
    if curTween == tw then curTween = nil end
end

local function flat(v) return Vector3.new(v.X, 0, v.Z) end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundAt(p, fallbackY)
    rayParams.FilterDescendantsInstances = { lp.Character }
    local hit = workspace:Raycast(Vector3.new(p.X, p.Y + 300, p.Z), Vector3.new(0, -800, 0), rayParams)
    return hit and (hit.Position.Y + 3) or fallbackY
end

local lastPathLog = 0

-- Đi bộ thật bằng Humanoid:MoveTo. Đường xa (hàng nghìn stud) thì Pathfinding không tính nổi,
-- nên chia thành các đoạn ~120 stud, mỗi đoạn tìm đường cục bộ; kẹt thì né sang bên rồi đi tiếp.
local function walkTo(pos)
    local root = getRoot()
    local hum = root and root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
    if not root or not hum or not pos or not alive then return end
    local startReset = resetInfo.at

    local function aborted()
        return not alive or getRoot() ~= root or resetInfo.at ~= startReset
            or not (S.AutoSlash or S.AutoSteal or S.AutoBoss) or (carry.active and carry.lost)
            or (hooks.interrupt ~= nil and hooks.interrupt())
    end

    -- đi tới 1 điểm; kẹt thì nhảy, MoveTo tự hết hạn sau 8s nên gọi lại định kỳ
    local function leg(p, timeout)
        local t0 = os.clock()
        local lastCheck, lastPos = t0, root.Position
        hum:MoveTo(p)
        while not aborted() and (flat(root.Position) - flat(p)).Magnitude > 5 and os.clock() - t0 < timeout do
            task.wait(0.1)
            local now = os.clock()
            if now - lastCheck > 1.5 then
                if (root.Position - lastPos).Magnitude < 2 then hum.Jump = true end
                lastPos, lastCheck = root.Position, now
                hum:MoveTo(p)
            end
        end
        return not aborted()
    end

    -- 1 đoạn ngắn: tìm đường cục bộ, không có thì đi thẳng
    local function hop(goal)
        local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
        local ok = pcall(function() path:ComputeAsync(root.Position, goal) end)
        if ok and path.Status == Enum.PathStatus.Success then
            for _, wp in ipairs(path:GetWaypoints()) do
                if aborted() then return end
                if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
                leg(wp.Position, 5)
            end
        else
            if os.clock() - lastPathLog > 30 then
                lastPathLog = os.clock()
                log("Không tìm được đường cục bộ, đi thẳng từng đoạn")
            end
            local t = (flat(root.Position) - flat(goal)).Magnitude / math.max(hum.WalkSpeed, 8) * 1.5 + 3
            leg(goal, t)
        end
    end

    local walkSpeed = math.max(hum.WalkSpeed, 8)
    local deadline = os.clock() + math.max(60, (flat(root.Position) - flat(pos)).Magnitude / walkSpeed * 2 + 30)
    local stuck, side = 0, 1
    while not aborted() and os.clock() < deadline do
        local cur = root.Position
        local to = flat(pos) - flat(cur)
        local dist = to.Magnitude
        if dist <= 6 then break end
        local dir = to.Unit
        local goal = cur + dir * math.min(dist, 120)
        goal = Vector3.new(goal.X, dist <= 120 and pos.Y or groundAt(goal, cur.Y), goal.Z)
        hop(goal)
        if aborted() then return end
        local moved = dist - (flat(root.Position) - flat(pos)).Magnitude
        if moved < 8 then
            stuck += 1
            if stuck >= 8 then
                log("Kẹt không đi tiếp được, bỏ đoạn này")
                return
            end
            -- né sang bên 50 stud (đổi bên mỗi lần kẹt) rồi đi tiếp
            local perp = Vector3.new(-dir.Z, 0, dir.X) * side
            local sp = root.Position + perp * 50
            sp = Vector3.new(sp.X, groundAt(sp, root.Position.Y), sp.Z)
            hum.Jump = true
            leg(sp, 6)
            side = -side
        else
            stuck = 0
        end
        task.wait(0.05)
    end
end

-- mode: "vertical" (dọc, Z trước rồi X) | "horizontal" (ngang, X trước rồi Z) | "straight"/nil (đi thẳng)
local function tweenTo(pos, speed, mode)
    local root = getRoot()
    if not root or not pos or not alive then return end
    if S.Move == "walk" then
        walkTo(pos)
        return
    end
    if mode == "vertical" or mode == "horizontal" then
        local cur = root.Position
        local wp
        if mode == "vertical" then
            wp = Vector3.new(cur.X, pos.Y, pos.Z)
        else
            wp = Vector3.new(pos.X, pos.Y, cur.Z)
        end
        if (wp - cur).Magnitude > 8 and (wp - pos).Magnitude > 8 then
            tweenDirect(wp, speed)
            if not alive or (carry.active and carry.lost) then return end
        end
    end
    tweenDirect(pos, speed)
end

-- Tele theo bước: mỗi 0.05s nhảy tối đa S.TeleStep stud về phía đích (rất nhanh, boss không rượt kịp)
local function teleportTo(pos)
    if not pos or not alive then return end
    local target = pos + Vector3.new(0, 3, 0)
    moving.tele = true
    while alive do
        local root = getRoot()
        if not root then break end
        local delta = target - root.Position
        local d = delta.Magnitude
        if d <= 6 then break end
        local len = math.min(d, math.max(S.TeleStep, 20))
        root.CFrame = CFrame.new(root.Position + delta.Unit * len)
        root.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.05)
        if carry.active and carry.lost then break end
    end
    moving.tele = false
    moving.untilT = os.clock() + 0.6
end

-- Đi tới điểm xa: nếu chưa qua base thì đi về Home trước (tránh tường chắn từ khu xuất phát lên map cuối)
local function travelTo(pos, speed)
    if S.ViaHome and savedHome and pos and not lane.passedHome
        and (pos - savedHome).Magnitude > 150 then
        local root = getRoot()
        if root and (root.Position - savedHome).Magnitude > 45 then
            setStatus("Đi về base trước")
            log("Chưa qua base: đi về Home trước khi lên map cuối")
            tweenTo(savedHome, speed)
        end
        local r = getRoot()
        if r and (r.Position - savedHome).Magnitude <= 60 then lane.passedHome = true end
    end
    tweenTo(pos, speed)
end

local MULT = { k = 1e3, m = 1e6, b = 1e9, t = 1e12 }

local function parseIncome(text)
    local s = tostring(text):lower():gsub("[,%$%s]", "")
    local n, suf = s:match("^([%d%.]+)([kmbt]?)")
    n = tonumber(n)
    if not n then return 0 end
    return n * (MULT[suf] or 1)
end

local function fmtNum(n)
    if n >= 1e12 then return ("%.2fT"):format(n / 1e12) end
    if n >= 1e9 then return ("%.2fB"):format(n / 1e9) end
    if n >= 1e6 then return ("%.2fM"):format(n / 1e6) end
    if n >= 1e3 then return ("%.2fK"):format(n / 1e3) end
    return tostring(math.floor(n))
end

local function petIncome(pet)
    local best = 0
    for _, d in ipairs(pet:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text:find("/s") then
            best = math.max(best, parseIncome(d.Text))
        end
    end
    return best
end

local function asPrompt(inst)
    if inst:IsA("ProximityPrompt") then return inst end
    return inst:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function petOf(prompt)
    local m = prompt.Parent
    while m and m ~= workspace do
        if m:IsA("Model") and m:GetAttribute("SAE_PetUid") then return m end
        m = m.Parent
    end
    return nil
end

local function ancestorWithTag(inst, tag)
    local m = inst
    while m and m ~= workspace and m ~= game do
        if CollectionService:HasTag(m, tag) then return m end
        m = m.Parent
    end
    return nil
end

local function plotCenter(p)
    if p:IsA("Model") then return p:GetPivot().Position end
    if p:IsA("BasePart") then return p.Position end
    local part = p:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function attrs(inst)
    local t = {}
    for k, v in pairs(inst:GetAttributes()) do t[#t + 1] = k .. "=" .. tostring(v) end
    table.sort(t)
    return table.concat(t, ", ")
end

