repeat task.wait() until lp

local S = {
    AutoSlash = false,
    AutoSteal = false,
    BringHome = true,
    TeleportDelay = 0.05, -- Độ trễ giữa các bước dịch chuyển
}

local savedHome = nil
local savedEndMap = nil
local isReturning = false
local noclipConnection = nil

local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

-- Bật Noclip để tránh bị kẹt trong địa hình khi Teleport
local function enableNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if lp.Character then
                    for _, v in ipairs(lp.Character:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

-- HÀM DỊCH CHUYỂN TỨC THỜI (BYPASS ANTI-CHEAT)
local function teleportTo(targetPos)
    local root = getRoot()
    if not root or not targetPos then return end
    
    enableNoclip(true)
    
    local startPos = root.Position
    local dist = (startPos - targetPos).Magnitude
    
    -- Nếu khoảng cách gần, Teleport trực tiếp 1 lần
    if dist < 50 then
        root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    else
        -- Nếu khoảng cách xa, Teleport từng khoảng ngắn (Step TP) để Server nhận vị trí
        local steps = math.floor(dist / 30)
        for i = 1, steps do
            if not getRoot() then break end
            local lerpPos = startPos:Lerp(targetPos, i / steps)
            root.CFrame = CFrame.new(lerpPos + Vector3.new(0, 3, 0))
            task.wait(S.TeleportDelay)
        end
        root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    end
    
    task.wait(0.1)
    enableNoclip(false)
end

-- Ép buộc Dịch chuyển về Base ngay lập tức
local function forceTeleportHome()
    if not savedHome then
        print("[Kiet Hub] Bạn chưa Set Home (Base)!")
        return
    end
    if isReturning then return end
    
    isReturning = true
    print("[Kiet Hub] Đang dịch chuyển về Base...")
    teleportTo(savedHome)
    task.wait(0.3)
    isReturning = false
end

local function isCarryingPet()
    local char = lp.Character
    if not char then return false end
    
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then return true end
    end
    local backpack = lp:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then return true end
        end
    end
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Model") or (child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" and child.Name ~= "Head") then
            return true
        end
    end
    
    return false
end

local function interactPet(obj)
    if not obj then return end
    for _, prompt in ipairs(obj:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function()
                local oldHold = prompt.HoldDuration
                prompt.HoldDuration = 0
                fireproximityprompt(prompt)
                prompt.HoldDuration = oldHold
            end)
        end
    end
    
    local root = getRoot()
    if root then
        for _, part in ipairs(obj:GetDescendants()) do
            if part:IsA("BasePart") and part:FindFirstChildOfClass("TouchTransmitter") then
                pcall(function()
                    firetouchinterest(root, part, 0)
                    task.wait(0.05)
                    firetouchinterest(root, part, 1)
                end)
            end
        end
    end
end

local function findPetObject()
    local root = getRoot()
    if not root then return nil end
    
    local bestObj = nil
    local shortestDist = math.huge
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
            local hasTouch = obj:FindFirstChildWhichIsA("TouchTransmitter", true) ~= nil
            
            if (name:find("pet") or obj:GetAttribute("Pet") or hasPrompt or hasTouch) and not obj:IsDescendantOf(lp.Character) then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local dist = (root.Position - pos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    bestObj = obj
                end
            end
        end
    end
    return bestObj
end

