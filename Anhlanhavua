local function dumpBoss()
    local out = {}
    local function add(x) out[#out + 1] = x end
    add("== SERVER TIME ==")
    local t = workspace:GetServerTimeNow()
    add(("epoch=%d | phút server=%d"):format(t, math.floor(t / 60) % 60))
    add("== PvePortal ==")
    local portal = workspace:FindFirstChild("PvePortal")
    if portal then
        add(portal:GetFullName() .. " | " .. portal.ClassName .. " | pos=" .. tostring(getPos(portal)) .. " | " .. attrs(portal))
        for _, x in ipairs(portal:GetDescendants()) do
            if x:IsA("ProximityPrompt") then
                add("PROMPT " .. describePrompt(x))
            elseif x:IsA("BasePart") then
                add(("PART %s | pos=%s size=%s CanTouch=%s | %s"):format(
                    x:GetFullName(), tostring(x.Position), tostring(x.Size), tostring(x.CanTouch), attrs(x)))
            end
        end
    else
        add("không có workspace.PvePortal")
    end
    add("== UI (label có 'boss' hoặc dạng mm:ss) ==")
    local n = 0
    for _, x in ipairs(playerGui:GetDescendants()) do
        if x:IsA("TextLabel") and x.Text ~= "" and (x.Text:lower():find("boss", 1, true) or x.Text:lower():find("join", 1, true)
            or x.Text:lower():find("arena", 1, true) or x.Text:match("^%d+:%d%d$")) then
            n += 1
            if n <= 40 then add(x:GetFullName() .. " = '" .. x.Text .. "'") end
        end
    end
    add("== REMOTE liên quan boss/pve/arena ==")
    for _, x in ipairs(ReplicatedStorage:GetDescendants()) do
        if x:IsA("RemoteEvent") or x:IsA("RemoteFunction") then
            local nm = x.Name:lower()
            if nm:find("boss") or nm:find("pve") or nm:find("kitsune") or nm:find("arena") then
                add(x.ClassName .. " " .. x:GetFullName())
            end
        end
    end
    local ok = copyText(table.concat(out, "\n"))
    log(ok and ("Đã copy dump boss (" .. #out .. " dòng)") or "Không có clipboard, đã in ra console (F9)")
end

local rec = { on = false, lines = {} }

local function recAdd(s)
    if rec.on then
        rec.lines[#rec.lines + 1] = os.date("%H:%M:%S ") .. s
        log("REC: " .. s)
    end
end

conns[#conns + 1] = ProximityPromptService.PromptTriggered:Connect(function(p, plr)
    if plr == lp then recAdd("TRIGGER " .. describePrompt(p)) end
end)

local function argToText(v)
    if type(v) == "table" then
        local ok, j = pcall(HttpService.JSONEncode, HttpService, v)
        return ok and j or "{table}"
    end
    return tostring(v)
end

local function hookRemote(name)
    local folder = ReplicatedStorage:FindFirstChild("Remotes")
    local r = folder and folder:FindFirstChild(name)
    if not (r and r:IsA("RemoteEvent")) then return end
    conns[#conns + 1] = r.OnClientEvent:Connect(function(...)
        local parts = {}
        for i = 1, select("#", ...) do parts[#parts + 1] = argToText((select(i, ...))) end
        local msg = table.concat(parts, " | ")
        recAdd(name .. ": " .. msg)
        if msg:lower():find("reset", 1, true) and (S.AutoSlash or S.AutoSteal or S.AutoBoss) then
            onMapReset(name .. ": " .. msg)
        end
        if carry.active then
            log(name .. ": " .. msg)
            local low = msg:lower()
            for _, k in ipairs(LOST_WORDS) do
                if low:find(k, 1, true) then
                    markLost(name .. ": " .. msg)
                    break
                end
            end
        end
    end)
end
hookRemote("Notify")
hookRemote("Announce")

local function watchBackpack(bp)
    conns[#conns + 1] = bp.ChildAdded:Connect(function(t) recAdd("BACKPACK + " .. t.Name) end)
    conns[#conns + 1] = bp.ChildRemoved:Connect(function(t) recAdd("BACKPACK - " .. t.Name) end)
end
local function watchChar(ch)
    conns[#conns + 1] = ch.ChildAdded:Connect(function(t)
        if t:IsA("Tool") then recAdd("EQUIP + " .. t.Name) end
    end)
    conns[#conns + 1] = ch.ChildRemoved:Connect(function(t)
        if t:IsA("Tool") then recAdd("EQUIP - " .. t.Name) end
    end)
end
do
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then watchBackpack(bp) end
    if lp.Character then watchChar(lp.Character) end
    conns[#conns + 1] = lp.ChildAdded:Connect(function(c)
        if c:IsA("Backpack") then watchBackpack(c) end
    end)
    conns[#conns + 1] = lp.CharacterAdded:Connect(watchChar)
end

