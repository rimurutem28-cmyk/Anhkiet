local function guiShown(g)
    local o = g
    while o and o ~= playerGui do
        if o:IsA("GuiObject") and not o.Visible then return false end
        if o:IsA("ScreenGui") and not o.Enabled then return false end
        o = o.Parent
    end
    return true
end

-- Đường dẫn thật của game (theo dump): PlayerGui.KitsuneArenaCall.Call.Sub = 'TAP TO JOIN'
local function findJoinBanner()
    local sg = playerGui:FindFirstChild("KitsuneArenaCall")
    local call = sg and sg:FindFirstChild("Call")
    local sub = call and call:FindFirstChild("Sub")
    if sub and sub:IsA("TextLabel") and sub.Text:upper():find("TAP TO JOIN", 1, true) and guiShown(sub) then
        return sub
    end
    return nil
end

-- nút bấm nằm đè lên chữ (trong 2 cấp cha), kiểm tra tâm chữ nằm trong nút cho chắc
local function findButtonFor(label)
    local center = label.AbsolutePosition + label.AbsoluteSize / 2
    local function covers(b)
        local p, sz = b.AbsolutePosition, b.AbsoluteSize
        return center.X >= p.X and center.X <= p.X + sz.X and center.Y >= p.Y and center.Y <= p.Y + sz.Y
    end
    local o = label
    while o and o ~= playerGui do
        if (o:IsA("TextButton") or o:IsA("ImageButton")) and covers(o) then return o end
        o = o.Parent
    end
    local parent = label.Parent
    for _ = 1, 2 do
        if not parent or parent == playerGui then break end
        for _, b in ipairs(parent:GetDescendants()) do
            if (b:IsA("TextButton") or b:IsA("ImageButton")) and covers(b) then return b end
        end
        parent = parent.Parent
    end
    return nil
end

local function activateGui(btn)
    local fired = false
    if getconnections then
        for _, sig in ipairs({ btn.MouseButton1Click, btn.Activated, btn.MouseButton1Down, btn.MouseButton1Up }) do
            local ok, list = pcall(getconnections, sig)
            if ok and list then
                for _, cn in ipairs(list) do
                    pcall(function() cn:Fire() end)
                    fired = true
                end
            end
        end
    end
    if firesignal and not fired then
        pcall(firesignal, btn.MouseButton1Click)
        pcall(firesignal, btn.Activated)
        fired = true
    end
    return fired
end

local function clickAt(x, y)
    local inset = GuiService:GetGuiInset()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y + inset.Y, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(x, y + inset.Y, 0, false, game, 0)
    end)
end

local function joinBossBanner()
    local label = findJoinBanner()
    if not label then return false end
    log("Thấy thông báo boss, đang bấm tham gia")
    local r0 = getRoot()
    local before = r0 and r0.Position
    local btn = findButtonFor(label)
    if btn then activateGui(btn) end
    task.wait(0.8)
    local r1 = getRoot()
    if r1 and before and (r1.Position - before).Magnitude > 120 then return true end
    -- chưa vào: chạm ảo vào giữa banner
    local c = label.AbsolutePosition + label.AbsoluteSize / 2
    clickAt(c.X, c.Y)
    task.wait(2.5)
    local r = getRoot()
    return r ~= nil and before ~= nil and (r.Position - before).Magnitude > 120
end

local function bossWindowActive()
    return findJoinBanner() ~= nil
end

-- true = đang bận chuyện boss (bỏ qua farm lượt này)
local function bossStep()
    if not S.AutoBoss then return false end
    local active = bossWindowActive()
    if boss.inFight then
        if active and os.clock() - boss.enteredAt < S.BossStay * 60 then
            setStatus("Ở map boss (pet tự đánh)")
            task.wait(1)
            return true
        end
        boss.inFight = false
        boss.cooldownUntil = os.clock() + 600
        log("Hết thời gian boss, quay lại farm")
        return false
    end
    if active and os.clock() >= boss.cooldownUntil and os.clock() - boss.lastTry > 20 then
        boss.lastTry = os.clock()
        moving.untilT = os.clock() + 30 -- bị dịch chuyển vào arena không tính là reset
        local ok = joinBossBanner()
        moving.untilT = os.clock() + 3
        if ok then
            boss.inFight = true
            boss.enteredAt = os.clock()
            log("Đã vào map boss")
        else
            log("Bấm tham gia boss chưa vào được, thử lại sau 20s")
        end
        return true
    end
    return false
end

-- Boss bật lên thì ngắt chuyến đi bộ/tween đang chạy để bossStep kịp bấm tham gia (không ngắt khi đang mang pet)
hooks.interrupt = function()
    return S.AutoBoss and not boss.inFight and not carry.active
        and os.clock() >= boss.cooldownUntil and os.clock() - boss.lastTry > 20
        and bossWindowActive()
end

