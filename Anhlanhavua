local function GetCharacter()
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            return char, hrp, hum
        end
    end
    return nil, nil, nil
end

local function ToggleNoclip(state)
    if state then
        if not NoclipConnection then
            NoclipConnection = RunService.Stepped:Connect(function()
                local char = GetCharacter()
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

-- Teleport An Toàn Bypass Anti-Cheat
local function Teleport(targetPos)
    local _, hrp = GetCharacter()
    if not hrp or not targetPos then return end

    ToggleNoclip(true)
    local startPos = hrp.Position
    local distance = (startPos - targetPos).Magnitude

    if distance <= 35 then
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2.5, 0))
    else
        local steps = math.clamp(math.floor(distance / 25), 2, 20)
        for i = 1, steps do
            local _, currentHrp = GetCharacter()
            if not currentHrp then break end
            local lerpPos = startPos:Lerp(targetPos, i / steps)
            currentHrp.CFrame = CFrame.new(lerpPos + Vector3.new(0, 2.5, 0))
            task.wait(Config.TeleportSpeed)
        end
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2.5, 0))
    end

    task.wait(0.1)
    ToggleNoclip(false)
end

-- TƯƠNG TÁC BẮT PET
local function TriggerInteraction(target)
    if not target then return false end
    local triggered = false

    -- 1. ProximityPrompt
    for _, prompt in ipairs(target:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function()
                local oldHold = prompt.HoldDuration
                prompt.HoldDuration = 0
                fireproximityprompt(prompt)
                prompt.HoldDuration = oldHold
                triggered = true
            end)
        end
    end

    -- 2. TouchInterest (Hitbox)
    local _, hrp = GetCharacter()
    if hrp then
        for _, part in ipairs(target:GetDescendants()) do
            if part:IsA("BasePart") and part:FindFirstChildOfClass("TouchTransmitter") then
                pcall(function()
                    firetouchinterest(hrp, part, 0)
                    task.wait(0.02)
                    firetouchinterest(hrp, part, 1)
                    triggered = true
                end)
            end
        end
    end

    return triggered
end

-- TÌM PET TRÊN MAP
local function FindPet()
    local _, hrp = GetCharacter()
    if not hrp then return nil end

    local bestTarget = nil
    local shortestDist = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            local hasTouch = obj:FindFirstChildWhichIsA("TouchTransmitter", true)

            if (name:find("pet") or obj:GetAttribute("Pet") or hasPrompt or hasTouch) and not obj:IsDescendantOf(LocalPlayer.Character) then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local dist = (hrp.Position - pos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    bestTarget = obj
                end
            end
        end
    end

    return bestTarget
end

