local noclipConnection = nil

local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

-- Bật Noclip để không bị dính map hoặc bị Anti-Cheat kéo lại khi vác Pet
local function enableNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if lp.Character then
                    for _, v in ipairs(lp.Character:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

-- Tween di chuyển an toàn bypass Anti-cheat
local function safeMoveTo(pos, speed)
    local root = getRoot()
    if not root or not pos then return end
    
    local dist = (root.Position - pos).Magnitude
    if dist < 4 then return end
    
    enableNoclip(true)
    
    local spd = speed or S.Speed
    local t = dist / spd
    
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
    })
    
    tw:Play()
    
    local elapsedTime = 0
    while elapsedTime < t do
        if not getRoot() then tw:Cancel() break end
        task.wait(0.05)
        elapsedTime = elapsedTime + 0.05
    end
    
    enableNoclip(false)
    task.wait(0.2) -- Dừng nghỉ để Server đồng bộ vị trí
end

-- Tự động bấm nút ProximityPrompt chuẩn
local function firePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    pcall(function()
        fireproximityprompt(prompt)
    end)
end

-- Tìm ProximityPrompt gần nhất trong phạm vi
local function findNearestPrompt()
    local root = getRoot()
    if not root then return nil, nil end
    
    local nearestPrompt = nil
    local nearestObj = nil
    local shortestDist = S.ScanRange
    
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
            local parent = prompt.Parent
            if parent then
                local pos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent:GetPivot().Position)
                if pos then
                    local dist = (root.Position - pos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestPrompt = prompt
                        nearestObj = parent
                    end
                end
            end
        end
    end
    
    return nearestObj, nearestPrompt
end

-- Tự equip kiếm/tool để chém
local function autoEquipTool()
    local char = lp.Character
    if not char then return end
    
    local currentTool = char:FindFirstChildOfClass("Tool")
    if not currentTool then
        local backpack = lp:FindFirstChild("Backpack")
        if backpack then
            local tool = backpack:FindFirstChildOfClass("Tool")
            if tool then
                tool.Parent = char
                currentTool = tool
            end
        end
    end
    
    if currentTool then
        pcall(function() currentTool:Activate() end)
    end
end

-- XỬ LÝ VÒNG LẶP CHÍNH
task.spawn(function()
    while true do
        task.wait(0.25)
        
        -- 1. ƯU TIÊN BẮT PET & MANG VỀ BASE
        if S.AutoSteal and not isBusy then
            local obj, prompt = findNearestPrompt()
            
            if prompt then
                isBusy = true
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                
                -- Di chuyển tới Pet
                safeMoveTo(pos, S.Speed)
                task.wait(0.1)
                
                -- Bấm nút bắt Pet
                firePrompt(prompt)
                task.wait(0.4)
                
                -- Vác về Base nếu đã lưu vị trí Base
                if S.BringHome and savedHome then
                    safeMoveTo(savedHome, S.ReturnSpeed)
                    task.wait(0.6) -- Chờ server xác nhận pet đã vào base
                end
                
                isBusy = false
            end
        end
        
        -- 2. TỰ ĐỘNG CHÉM TRỨNG / CÀY MAP CUỐI
        if S.AutoSlash and not isBusy then
            -- Nếu có vị trí Map Cuối, tự bay tới Map Cuối
            if savedEndMap then
                local root = getRoot()
                if root and (root.Position - savedEndMap).Magnitude > 15 then
                    safeMoveTo(savedEndMap, S.Speed)
                    task.wait(0.2)
                end
            end
            
            -- Đánh / Chém
            autoEquipTool()
            
            local obj, prompt = findNearestPrompt()
            if prompt then
                firePrompt(prompt)
            end
        end
    end
end)

