local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

local function enableNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if lp.Character then
                    for _, v in ipairs(lp.Character:GetDescendants()) do
                        if v:IsA("BasePart") then
                            v.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

local function safeMoveTo(pos, speed)
    local root = getRoot()
    if not root or not pos then return end
    
    local dist = (root.Position - pos).Magnitude
    if dist < 4 then return end
    
    enableNoclip(true)
    local spd = speed or S.Speed
    local t = dist / spd
    
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
    })
    
    tw:Play()
    
    local elapsedTime = 0
    while elapsedTime < t do
        if not getRoot() then tw:Cancel() break end
        task.wait(0.05)
        elapsedTime = elapsedTime + 0.05
    end
    
    enableNoclip(false)
    task.wait(0.15)
end

local function isCarryingPet()
    local char = lp.Character
    if not char then return false end
    
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("pet") or item.Name:lower():find("egg") or item:GetAttribute("Pet")) then
            return true
        end
    end
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Model") or child:IsA("BasePart") then
            local n = child.Name:lower()
            if n:find("pet") or child:GetAttribute("Carrying") or child:GetAttribute("Pet") then
                return true
            end
        end
    end
    
    if char:GetAttribute("Carrying") or char:GetAttribute("HasPet") or lp:GetAttribute("Carrying") then
        return true
    end
    
    return false
end

local function interactPet(obj)
    if not obj then return end
    
    for _, prompt in ipairs(obj:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function()
                local oldHold = prompt.HoldDuration
                prompt.HoldDuration = 0
                fireproximityprompt(prompt)
                prompt.HoldDuration = oldHold
            end)
        end
    end
    
    local root = getRoot()
    if root then
        for _, part in ipairs(obj:GetDescendants()) do
            if part:IsA("BasePart") and part:FindFirstChildOfClass("TouchTransmitter") then
                pcall(function()
                    firetouchinterest(root, part, 0)
                    task.wait(0.05)
                    firetouchinterest(root, part, 1)
                end)
            end
        end
    end
end

local function findPetObject()
    local root = getRoot()
    if not root then return nil end
    
    local bestObj = nil
    local shortestDist = math.huge
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
            local hasTouch = obj:FindFirstChildWhichIsA("TouchTransmitter", true) ~= nil
            
            if (name:find("pet") or obj:GetAttribute("Pet") or hasPrompt or hasTouch) and not obj:IsDescendantOf(lp.Character) then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local dist = (root.Position - pos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    bestObj = obj
                end
            end
        end
    end
    return bestObj
end

