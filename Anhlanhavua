--[[
    Kiet Hub - Game Info Dumper
    Dùng để lấy thông tin chính xác của Slash and Steal Pets
    Chạy script này → copy toàn bộ output trong Console/F9 gửi lại
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local lp = Players.LocalPlayer
repeat task.wait() until lp

print("========== KIET GAME INFO DUMPER ==========")
print("Game:", game.PlaceId, game.Name)
print("Player:", lp.Name, lp.UserId)
print("")

-- 1. Remotes
print("----- REMOTES / BINDABLE -----")
local function scanRemotes(parent, path)
    path = path or parent.Name
    for _, obj in ipairs(parent:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("UnreliableRemoteEvent") then
            print(obj.ClassName .. " | " .. path .. "/" .. obj.Name)
        end
        if #obj:GetChildren() > 0 and not obj:IsA("Player") then
            scanRemotes(obj, path .. "/" .. obj.Name)
        end
    end
end

print("[ReplicatedStorage]")
scanRemotes(ReplicatedStorage)

if game:GetService("ReplicatedFirst") then
    print("\n[ReplicatedFirst]")
    pcall(function() scanRemotes(game:GetService("ReplicatedFirst")) end)
end

-- 2. CollectionService Tags
print("\n----- COLLECTION SERVICE TAGS -----")
pcall(function()
    local tags = {}
    for _, inst in ipairs(workspace:GetDescendants()) do
        for _, tag in ipairs(CollectionService:GetTags(inst)) do
            tags[tag] = (tags[tag] or 0) + 1
        end
    end
    for tag, count in pairs(tags) do
        print("Tag:", tag, "| Count:", count)
    end
end)

-- 3. Workspace structure (top level)
print("\n----- WORKSPACE TOP LEVEL -----")
for _, obj in ipairs(workspace:GetChildren()) do
    print(obj.ClassName, "|", obj.Name)
end

-- 4. Find Eggs
print("\n----- EGGS (sample) -----")
local eggCount = 0
for _, obj in ipairs(workspace:GetDescendants()) do
    local name = obj.Name:lower()
    if (name:find("egg") or obj:GetAttribute("Egg") or obj:HasTag("Egg")) and eggCount < 8 then
        eggCount += 1
        print("Egg:", obj:GetFullName())
        print("  Class:", obj.ClassName)
        for attr, val in pairs(obj:GetAttributes()) do
            print("  Attr:", attr, "=", val)
        end
        for _, c in ipairs(obj:GetChildren()) do
            if c:IsA("ProximityPrompt") or c:IsA("ClickDetector") or c:IsA("BasePart") then
                print("  Child:", c.ClassName, c.Name)
            end
        end
    end
end
print("Total eggs found (sample max 8):", eggCount)

-- 5. Find Pets
print("\n----- PETS (sample) -----")
local petCount = 0
for _, obj in ipairs(workspace:GetDescendants()) do
    local name = obj.Name:lower()
    if (name:find("pet") or obj:GetAttribute("Pet") or obj:HasTag("Pet")) and petCount < 8 then
        petCount += 1
        print("Pet:", obj:GetFullName())
        print("  Class:", obj.ClassName)
        for attr, val in pairs(obj:GetAttributes()) do
            print("  Attr:", attr, "=", val)
        end
        -- Billboards
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text ~= "" then
                print("  Text:", d.Text)
            end
        end
    end
end
print("Total pets found (sample max 8):", petCount)

-- 6. Player character tools
print("\n----- CHARACTER / TOOLS -----")
local char = lp.Character
if char then
    for _, v in ipairs(char:GetChildren()) do
        print(v.ClassName, v.Name)
    end
    local backpack = lp:FindFirstChild("Backpack")
    if backpack then
        print("[Backpack]")
        for _, v in ipairs(backpack:GetChildren()) do
            print(" ", v.ClassName, v.Name)
        end
    end
end

-- 7. Possible base/plot
print("\n----- POSSIBLE BASES / PLOTS -----")
for _, name in ipairs({"Plots", "Bases", "PlayerPlots", "Farms", "Homes", "Tycoons", "PlayerBases", "Plot"}) do
    local f = workspace:FindFirstChild(name)
    if f then
        print("Found folder:", name)
        for i, p in ipairs(f:GetChildren()) do
            if i <= 5 then
                print("  ", p.Name, p.ClassName)
                for attr, val in pairs(p:GetAttributes()) do
                    print("    Attr:", attr, "=", val)
                end
            end
        end
    end
end

-- 8. Shared / Controllers
print("\n----- getrenv().shared / Controllers -----")
pcall(function()
    local shared = getrenv().shared
    if shared then
        for k, v in pairs(shared) do
            print("shared." .. tostring(k), type(v))
        end
    else
        print("No getrenv().shared")
    end
end)

print("\n========== END DUMP ==========")
print("Copy toàn bộ dòng trên (từ KIET GAME INFO đến END DUMP) gửi lại cho mình")
