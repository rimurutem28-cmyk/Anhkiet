----------------------------------------------------------------
-- Log / status (UI gán sau)
----------------------------------------------------------------
local logLines = {}
local logLabel, logScroll, statusLabel, statsLabel

local function log(msg)
    logLines[#logLines + 1] = os.date("%H:%M:%S ") .. tostring(msg)
    if #logLines > 120 then table.remove(logLines, 1) end
    if logLabel then
        logLabel.Text = table.concat(logLines, "\n")
        task.defer(function()
            if logScroll then logScroll.CanvasPosition = Vector2.new(0, 1e5) end
        end)
    end
end

local function setStatus(s)
    if statusLabel then statusLabel.Text = "Trạng thái: " .. s end
end

local function updateStats()
    if statsLabel then
        statsLabel.Text = ("Egg đã chém: %d  |  Pet đã lấy: %d"):format(stats.eggs, stats.pets)
    end
end

local function copyText(s)
    local f = setclipboard or toclipboard
    if f then
        local ok = pcall(f, s)
        if ok then return true end
    end
    print(s)
    return false
end

----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

local function getPos(inst)
    if not inst then return nil end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    return nil
end

local function tweenTo(pos, speed)
    local root = getRoot()
    if not root or not pos or not alive then return end
    local dist = (root.Position - pos).Magnitude
    if dist < 8 then return end
    local t = math.max(dist / (speed or S.Speed), 0.15)
    curTween = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)),
    })
    curTween:Play()
    curTween.Completed:Wait()
    curTween = nil
end

local MULT = { k = 1e3, m = 1e6, b = 1e9, t = 1e12 }

local function parseIncome(text)
    local s = tostring(text):lower():gsub("[,%$%s]", "")
    local n, suf = s:match("^([%d%.]+)([kmbt]?)")
    n = tonumber(n)
    if not n then return 0 end
    return n * (MULT[suf] or 1)
end

local function fmtNum(n)
    if n >= 1e12 then return ("%.2fT"):format(n / 1e12) end
    if n >= 1e9 then return ("%.2fB"):format(n / 1e9) end
    if n >= 1e6 then return ("%.2fM"):format(n / 1e6) end
    if n >= 1e3 then return ("%.2fK"):format(n / 1e3) end
    return tostring(math.floor(n))
end

local function petIncome(pet)
    local best = 0
    for _, d in ipairs(pet:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text:find("/s") then
            best = math.max(best, parseIncome(d.Text))
        end
    end
    return best
end

local function asPrompt(inst)
    if inst:IsA("ProximityPrompt") then return inst end
    return inst:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function petOf(prompt)
    local m = prompt.Parent
    while m and m ~= workspace do
        if m:IsA("Model") and m:GetAttribute("SAE_PetUid") then return m end
        m = m.Parent
    end
    return nil
end

local function ancestorWithTag(inst, tag)
    local m = inst
    while m and m ~= workspace and m ~= game do
        if CollectionService:HasTag(m, tag) then return m end
        m = m.Parent
    end
    return nil
end

local function plotCenter(p)
    if p:IsA("Model") then return p:GetPivot().Position end
    if p:IsA("BasePart") then return p.Position end
    local part = p:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function attrs(inst)
    local t = {}
    for k, v in pairs(inst:GetAttributes()) do t[#t + 1] = k .. "=" .. tostring(v) end
    table.sort(t)
    return table.concat(t, ", ")
end

-- Base của mình: ưu tiên theo pet đang đặt (SAE_OwnerUserId), không có thì lấy plot gần Home nhất
local function getMyPlot()
    local myId = tostring(lp.UserId)
    for _, tagged in ipairs(CollectionService:GetTagged("SAE_PetUnplacePrompt")) do
        local pr = asPrompt(tagged)
        if pr and tostring(pr:GetAttribute("SAE_OwnerUserId")) == myId then
            local plot = ancestorWithTag(pr, "SAE_Plot")
            if plot then return plot end
        end
    end
    if savedHome then
        local best, bd = nil, math.huge
        for _, plot in ipairs(CollectionService:GetTagged("SAE_Plot")) do
            local c = plotCenter(plot)
            if c then
                local d = (c - savedHome).Magnitude
                if d < bd then best, bd = plot, d end
            end
        end
        return best
    end
    return nil
end

----------------------------------------------------------------
-- Tool tracking (pet nhận được = tool mới trong Backpack)
----------------------------------------------------------------
local function snapshotTools()
    local set = {}
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do set[t] = true end
    end
    local ch = lp.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") then set[t] = true end
        end
    end
    return set
end

local function newTool(before)
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and not before[t] then return t end
        end
    end
    local ch = lp.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") and not before[t] then return t end
        end
    end
    return nil
end

local function waitNewTool(before, timeout)
    local t0 = os.clock()
    repeat
        local t = newTool(before)
        if t then return t end
        task.wait(0.1)
    until os.clock() - t0 >= timeout
    return nil
end

----------------------------------------------------------------
-- Place pet về base
----------------------------------------------------------------
local PLACE_WORDS = { "place", "put", "đặt", "dat ", "drop", "deposit" }
local BAD_WORDS = { "unplace", "pick", "steal", "take", "buy", "sell", "upgrade" }

local function looksLikePlace(prompt)
    local s = (prompt.ActionText .. " " .. prompt.ObjectText):lower()
    for _, w in ipairs(BAD_WORDS) do
        if s:find(w, 1, true) then return false end
    end
    for _, w in ipairs(PLACE_WORDS) do
        if s:find(w, 1, true) then return true end
    end
    return false
end

local function placePet(tool)
    setStatus("Đang đặt pet về base")
    local plot = getMyPlot()
    local home = savedHome or (plot and plotCenter(plot)) or startPos
    if not plot then
        log("Không xác định được base của bạn. Hãy bấm 'Set Home' khi đứng ở base.")
    end

    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and tool.Parent ~= char then
        hum:EquipTool(tool)
        task.wait(0.25)
    end
    tweenTo(home, S.ReturnSpeed)
    if not plot then return false end

    local function gone()
        return tool.Parent ~= lp.Character and tool.Parent ~= lp:FindFirstChildOfClass("Backpack")
    end

    local root = getRoot()
    local cands = {}
    for _, d in ipairs(plot:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled and looksLikePlace(d) then
            local pos = getPos(d.Parent)
            if pos and root then
                cands[#cands + 1] = { p = d, pos = pos, dist = (root.Position - pos).Magnitude }
            end
        end
    end
    table.sort(cands, function(a, b) return a.dist < b.dist end)

    if #cands == 0 then
        log("Không thấy prompt 'place/đặt' trong base. Dùng tab Setup > Ghi lại thao tác để gửi cách đặt pet.")
        return false
    end

    for i = 1, math.min(#cands, 4) do
        local c = cands[i]
        tweenTo(c.pos, S.ReturnSpeed)
        pcall(function() c.p.HoldDuration = 0 end)
        pcall(fireproximityprompt, c.p)
        task.wait(0.5)
        log("Thử prompt: " .. c.p:GetFullName())
        if gone() then
            log("Đặt pet thành công")
            return true
        end
    end
    log("Đã thử nhưng pet vẫn còn trong túi")
    return false
end

----------------------------------------------------------------
-- Steal
----------------------------------------------------------------
local function findBestTarget()
    local myId = tostring(lp.UserId)
    local now = os.clock()
    local best, bestInc = nil, 0
    for _, tagged in ipairs(CollectionService:GetTagged("SAE_PetUnplacePrompt")) do
        local prompt = tagged:IsDescendantOf(workspace) and asPrompt(tagged)
        if prompt and prompt.Enabled and not (tried[prompt] and now - tried[prompt] < 8) then
            local pet = petOf(prompt)
            local owner = prompt:GetAttribute("SAE_OwnerUserId")
            if owner == nil and pet then owner = pet:GetAttribute("SAE_OwnerUserId") end
            if pet and owner ~= nil and tostring(owner) ~= myId then
                local inc = petIncome(pet)
                if inc >= S.MinIncome and inc > bestInc then
                    best, bestInc = { pet = pet, prompt = prompt, inc = inc, owner = owner }, inc
                end
            end
        end
    end
    return best
end

local function stealOnce()
    local target = findBestTarget()
    if not target then return false end
    local prompt, pet = target.prompt, target.pet
    tried[prompt] = os.clock()

    setStatus("Đang tới " .. pet.Name)
    log(("Target: %s (%s/s) chủ %s"):format(pet.Name, fmtNum(target.inc), tostring(target.owner)))
    tweenTo(getPos(pet), S.Speed + 5)
    if not S.AutoSteal then return true end

    setStatus("Đang lấy pet")
    local before = snapshotTools()
    local origHold = prompt.HoldDuration
    local got

    -- Cách 1: fireproximityprompt
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
    end)
    for _ = 1, 3 do
        if not prompt:IsDescendantOf(workspace) then break end
        pcall(fireproximityprompt, prompt)
        got = waitNewTool(before, 0.8)
        if got then break end
    end

    -- Cách 2: giữ prompt thật theo HoldDuration gốc
    if not got and prompt:IsDescendantOf(workspace) then
        log("fireproximityprompt không ăn, thử giữ prompt thật...")
        pcall(function() prompt.HoldDuration = origHold end)
        pcall(function() prompt:InputHoldBegin() end)
        task.wait(origHold + 0.2)
        pcall(function() prompt:InputHoldEnd() end)
        got = waitNewTool(before, 1.2)
    end

    if got then
        stats.pets += 1
        log("Đã nhận pet: " .. got.Name)
    else
        log("Chưa nhận được pet (không có tool mới trong Backpack)")
    end
    updateStats()

    if S.BringHome then
        if got then
            placePet(got)
        else
            tweenTo(savedHome or startPos, S.ReturnSpeed)
        end
    end
    return true
end

----------------------------------------------------------------
-- Slash
----------------------------------------------------------------
local function isWeapon(t)
    return t:IsA("Tool") and not t.Name:find("/s") and t.Name ~= "Trap"
end

local function equipWeapon()
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local held = char:FindFirstChildOfClass("Tool")
    if held and isWeapon(held) then return held end
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if isWeapon(t) then
                hum:EquipTool(t)
                task.wait(0.2)
                return t
            end
        end
    end
    return nil
end

local function findEgg()
    local root = getRoot()
    if not root then return nil end
    local best, bestD = nil, 150
    for _, egg in ipairs(CollectionService:GetTagged("SAE_WorldEgg")) do
        local hp = egg:GetAttribute("SAE_EggHP")
        if type(hp) == "number" and hp > 0 and egg:IsDescendantOf(workspace) then
            local pos = getPos(egg)
            if pos then
                local d = (root.Position - pos).Magnitude
                if d < bestD then best, bestD = egg, d end
            end
        end
    end
    return best
end

local function slashOnce()
    local root = getRoot()
    if not root then return end
    local egg = findEgg()
    if not egg then
        setStatus("Chờ egg")
        if savedEndMap and (root.Position - savedEndMap).Magnitude > 45 then
            tweenTo(savedEndMap, S.Speed)
        end
        return
    end
    local tool = equipWeapon()
    if not tool then
        setStatus("Không có vũ khí trong túi")
        return
    end
    setStatus("Đang chém egg")
    tweenTo(getPos(egg), S.Speed)
    local n = 0
    while alive and S.AutoSlash and n < 40 and getRoot()
        and egg:IsDescendantOf(workspace)
        and (egg:GetAttribute("SAE_EggHP") or 0) > 0 do
        pcall(function() tool:Activate() end)
        n += 1
        task.wait(0.15)
    end
    if not egg:IsDescendantOf(workspace) or (egg:GetAttribute("SAE_EggHP") or 0) <= 0 then
        stats.eggs += 1
        updateStats()
    end
end

----------------------------------------------------------------
-- Main loop
----------------------------------------------------------------
local function step()
    if not getRoot() then return end
    if S.AutoSteal and stealOnce() then return end
    if S.AutoSlash then slashOnce() end
end

local function mainLoop()
    if looping then return end
    looping = true
    local r = getRoot()
    startPos = r and r.Position or startPos
    log("Bắt đầu chạy")
    while alive and (S.AutoSlash or S.AutoSteal) do
        local ok, err = pcall(step)
        if not ok then
            warn("[Kiet Hub] " .. tostring(err))
            log("LỖI: " .. tostring(err))
        end
        task.wait(0.3)
    end
    looping = false
    setStatus("Idle")
    log("Đã dừng")
end

local function refresh()
    if S.AutoSlash or S.AutoSteal then
        task.spawn(mainLoop)
    elseif curTween then
        curTween:Cancel()
    end
end

----------------------------------------------------------------
-- Dump info + Recorder
----------------------------------------------------------------
local function describePrompt(p)
    local m = p.Parent
    while m and not m:IsA("Model") and m ~= workspace do m = m.Parent end
    return ("%s | Action='%s' Object='%s' Hold=%s Dist=%s Enabled=%s | attrs{%s} | model=%s attrs{%s}"):format(
        p:GetFullName(), p.ActionText, p.ObjectText, tostring(p.HoldDuration),
        tostring(p.MaxActivationDistance), tostring(p.Enabled), attrs(p),
        m and m:GetFullName() or "?", m and attrs(m) or "")
end

local function dumpInfo()
    local out = {}
    local function add(s) out[#out + 1] = s end
    local root = getRoot()

    add("== SELF ==")
    add("UserId=" .. lp.UserId .. " pos=" .. tostring(root and root.Position) .. " savedHome=" .. tostring(savedHome))

    add("== PLOTS (tag SAE_Plot) ==")
    for _, p in ipairs(CollectionService:GetTagged("SAE_Plot")) do
        add(p:GetFullName() .. " | " .. p.ClassName .. " | " .. attrs(p))
    end

    add("== SAE_BaseOwnerTag ==")
    for _, c in ipairs(workspace:GetChildren()) do
        if c.Name == "SAE_BaseOwnerTag" then
            add(c:GetFullName() .. " | pos=" .. tostring(getPos(c)) .. " | " .. attrs(c))
        end
    end

    add("== NESTS (5 đầu, tag SAE_Nest) ==")
    for i, n in ipairs(CollectionService:GetTagged("SAE_Nest")) do
        if i > 5 then break end
        add(n:GetFullName() .. " | " .. n.ClassName .. " | " .. attrs(n))
        for _, d in ipairs(n:GetDescendants()) do
            if d:IsA("ProximityPrompt") then add("   " .. describePrompt(d)) end
        end
    end

    add("== BACKPACK ==")
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do add(t.Name .. " | " .. t.ClassName .. " | " .. attrs(t)) end
    end

    add("== PROMPT TRONG 60 STUD ==")
    local count = 0
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and root then
            local pos = getPos(d.Parent)
            if pos and (pos - root.Position).Magnitude <= 60 then
                count += 1
                if count <= 80 then add(describePrompt(d)) end
            end
        end
    end

    local text = table.concat(out, "\n")
    local ok = copyText(text)
    log(ok and ("Đã copy dump (" .. #out .. " dòng) vào clipboard") or "Không có clipboard, đã in ra console (F9)")
end

local rec = { on = false, lines = {} }

local function recAdd(s)
    if rec.on then
        rec.lines[#rec.lines + 1] = os.date("%H:%M:%S ") .. s
        log("REC: " .. s)
    end
end

conns[#conns + 1] = ProximityPromptService.PromptTriggered:Connect(function(p, plr)
    if plr == lp then recAdd("TRIGGER " .. describePrompt(p)) end
end)

local function watchBackpack(bp)
    conns[#conns + 1] = bp.ChildAdded:Connect(function(t) recAdd("BACKPACK + " .. t.Name) end)
    conns[#conns + 1] = bp.ChildRemoved:Connect(function(t) recAdd("BACKPACK - " .. t.Name) end)
end
local function watchChar(ch)
    conns[#conns + 1] = ch.ChildAdded:Connect(function(t)
        if t:IsA("Tool") then recAdd("EQUIP + " .. t.Name) end
    end)
    conns[#conns + 1] = ch.ChildRemoved:Connect(function(t)
        if t:IsA("Tool") then recAdd("EQUIP - " .. t.Name) end
    end)
end
do
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then watchBackpack(bp) end
    if lp.Character then watchChar(lp.Character) end
    conns[#conns + 1] = lp.ChildAdded:Connect(function(c)
        if c:IsA("Backpack") then watchBackpack(c) end
    end)
    conns[#conns + 1] = lp.CharacterAdded:Connect(watchChar)
end

