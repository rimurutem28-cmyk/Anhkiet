    Kiet Hub - Slash and Steal Pets
    Auto Slash Egg + Auto Steal Pet (≥ 20M/s)
    + Icon bật/tắt UI (mobile)
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local lp = Players.LocalPlayer
repeat task.wait() until lp

-- ==================== SETTINGS ====================
local S = {
    AutoSlash = false,
    AutoSteal = false,
    MinIncome = 20000000, -- 20M/s
    SlashRange = 30,
    StealRange = 45,
    BringHome = true,
    SpamClick = true,
    Speed = 90,
}

local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            return hrp, hum, char
        end
    end
    return nil
end

local function tweenTo(pos, speed)
    local root = getRoot()
    if not root then return end
    local dist = (root.Position - pos).Magnitude
    if dist < 4 then return end
    local t = math.clamp(dist / (speed or S.Speed), 0.25, 3.5)
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    })
    tw:Play()
    tw.Completed:Wait()
end

local function spamClick(times)
    times = times or 6
    for i = 1, times do
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            task.wait(0.04)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end)
        task.wait(0.07)
    end
end

local function fireAllPrompts(obj)
    if not obj then return end
    for _, v in ipairs(obj:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(v) end)
        end
    end
end

-- ==================== FIND EGGS ====================
local function isEgg(obj)
    local name = obj.Name:lower()
    if name:find("egg") then return true end
    if obj:GetAttribute("Egg") or obj:GetAttribute("IsEgg") then return true end
    if obj:HasTag("Egg") then return true end
    if obj:IsA("Model") and obj:FindFirstChild("Egg") then return true end
    return false
end

local function findNearestEgg()
    local root = getRoot()
    if not root then return nil end

    local nearest, minDist = nil, S.SlashRange
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("MeshPart")) and isEgg(obj) then
            local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
            local dist = (root.Position - pos).Magnitude
            if dist < minDist then
                nearest = obj
                minDist = dist
            end
        end
    end
    return nearest
end

-- ==================== FIND PETS ====================
local function parseIncome(text)
    if not text then return 0 end
    text = text:lower():gsub(",", ""):gsub("%$", ""):gsub("%s", "")
    local num, suffix = text:match("([%d%.]+)([kmb]?)")
    if not num then return 0 end
    num = tonumber(num) or 0
    if suffix == "k" then return num * 1e3 end
    if suffix == "m" then return num * 1e6 end
    if suffix == "b" then return num * 1e9 end
    return num
end

local function getPetIncome(obj)
    local attrs = {"Income", "MoneyPerSecond", "CashPerSec", "Value", "MPS", "Earnings", "Gen", "Money"}
    for _, a in ipairs(attrs) do
        local v = obj:GetAttribute(a)
        if type(v) == "number" and v > 0 then return v end
        if type(v) == "string" then
            local n = parseIncome(v)
            if n > 0 then return n end
        end
    end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local n = parseIncome(d.Text)
            if n >= S.MinIncome then return n end
        end
    end
    return 0
end

local function isPet(obj)
    local name = obj.Name:lower()
    if name:find("pet") or name:find("animal") then return true end
    if obj:GetAttribute("Pet") or obj:GetAttribute("IsPet") then return true end
    if obj:HasTag("Pet") then return true end
    if obj:IsA("Model") and getPetIncome(obj) > 0 then return true end
    return false
end

local function findBestPet()
    local root = getRoot()
    if not root then return nil, 0 end

    local best, bestIncome, bestDist = nil, S.MinIncome - 1, S.StealRange
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and isPet(obj) then
            local income = getPetIncome(obj)
            if income >= S.MinIncome then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local dist = (root.Position - pos).Magnitude
                if dist < bestDist or (income > bestIncome and dist < S.StealRange * 1.8) then
                    best = obj
                    bestIncome = income
                    bestDist = dist
                end
            end
        end
    end
    return best, bestIncome
end

local function getHomePos()
    local folders = {"Plots", "Bases", "PlayerPlots", "Farms", "Homes", "Tycoons"}
    for _, fname in ipairs(folders) do
        local folder = workspace:FindFirstChild(fname)
        if folder then
            for _, p in ipairs(folder:GetChildren()) do
                if p:GetAttribute("Owner") == lp.UserId 
                or p:GetAttribute("OwnerId") == lp.UserId
                or p.Name == tostring(lp.UserId)
                or p.Name == lp.Name then
                    return p:IsA("Model") and p:GetPivot().Position or p.Position
                end
            end
        end
    end
    local root = getRoot()
    return root and root.Position or Vector3.new(0, 5, 0)
end

-- ==================== LOOPS ====================
local function autoSlashLoop()
    while S.AutoSlash do
        local egg = findNearestEgg()
        if egg then
            local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
            tweenTo(pos, S.Speed)
            if S.SpamClick then spamClick(10) end
            fireAllPrompts(egg)
            local char = lp.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
            end
        end
        task.wait(0.35)
    end
end

local function autoStealLoop()
    while S.AutoSteal do
        local pet, income = findBestPet()
        if pet then
            local pos = pet:IsA("Model") and pet:GetPivot().Position or pet.Position
            tweenTo(pos, S.Speed + 10)
            fireAllPrompts(pet)
            spamClick(4)
            local prompt = pet:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then pcall(fireproximityprompt, prompt) end
            task.wait(0.4)
            if S.BringHome then
                local home = getHomePos()
                tweenTo(home, S.Speed + 15)
            end
        end
        task.wait(0.5)
    end
end

