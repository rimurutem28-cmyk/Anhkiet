local function argToText(v)
    if type(v) == "table" then
        local ok, j = pcall(HttpService.JSONEncode, HttpService, v)
        return ok and j or "{table}"
    end
    return tostring(v)
end

local function hookRemote(name)
    local folder = ReplicatedStorage:FindFirstChild("Remotes")
    local r = folder and folder:FindFirstChild(name)
    if not (r and r:IsA("RemoteEvent")) then return end
    conns[#conns + 1] = r.OnClientEvent:Connect(function(...)
        local parts = {}
        for i = 1, select("#", ...) do parts[#parts + 1] = argToText((select(i, ...))) end
        local msg = table.concat(parts, " | ")
        recAdd(name .. ": " .. msg)
        if msg:lower():find("reset", 1, true) and (S.AutoSlash or S.AutoSteal) then
            onMapReset(name .. ": " .. msg)
        end
        if carry.active then
            log(name .. ": " .. msg)
            local low = msg:lower()
            for _, k in ipairs(LOST_WORDS) do
                if low:find(k, 1, true) then
                    markLost(name .. ": " .. msg)
                    break
                end
            end
        end
    end)
end
hookRemote("Notify")
hookRemote("Announce")

local function watchBackpack(bp)
    conns[#conns + 1] = bp.ChildAdded:Connect(function(t) recAdd("BACKPACK + " .. t.Name) end)
    conns[#conns + 1] = bp.ChildRemoved:Connect(function(t) recAdd("BACKPACK - " .. t.Name) end)
end
local function watchChar(ch)
    conns[#conns + 1] = ch.ChildAdded:Connect(function(t)
        if t:IsA("Tool") then recAdd("EQUIP + " .. t.Name) end
    end)
    conns[#conns + 1] = ch.ChildRemoved:Connect(function(t)
        if t:IsA("Tool") then recAdd("EQUIP - " .. t.Name) end
    end)
end
do
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then watchBackpack(bp) end
    if lp.Character then watchChar(lp.Character) end
    conns[#conns + 1] = lp.ChildAdded:Connect(function(c)
        if c:IsA("Backpack") then watchBackpack(c) end
    end)
    conns[#conns + 1] = lp.CharacterAdded:Connect(watchChar)
end

