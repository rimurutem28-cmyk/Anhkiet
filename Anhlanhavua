local function makeToggle(name, y, key)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 34)
    btn.Position = UDim2.new(0, 10, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(32, 34, 44)
    btn.Text = name .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(220, 220, 230)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        Settings[key] = not Settings[key]
        btn.Text = name .. ": " .. (Settings[key] and "ON" or "OFF")
        btn.BackgroundColor3 = Settings[key] and Color3.fromRGB(0, 140, 200) or Color3.fromRGB(32, 34, 44)

        if key == "AutoBreak" and Settings.AutoBreak then
            task.spawn(autoBreak)
        elseif key == "AutoSteal" and Settings.AutoSteal then
            task.spawn(autoSteal)
        end
    end)
end

