--[[
    Kiet Hub - Slash and Steal Pets (Auto-Fix Detection & Distance)
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer

repeat task.wait() until lp

local S = {
    AutoSlash = false,
    AutoSteal = false,
    BringHome = true,
    Speed = 50,
    ReturnSpeed = 40,
}

local savedHome = nil
local savedEndMap = nil
local isBusy = false

local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

local function tweenTo(pos, speed)
    local root = getRoot()
    if not root or not pos then return end
    
    local dist = (root.Position - pos).Magnitude
    if dist < 4 then return end
    
    local spd = speed or S.Speed
    local t = math.clamp(dist / spd, 0.2, 8)
    
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
    })
    
    tw:Play()
    
    local elapsedTime = 0
    while elapsedTime < t do
        if not getRoot() then tw:Cancel() break end
        task.wait(0.05)
        elapsedTime = elapsedTime + 0.05
    end
end

-- Kích hoạt ProximityPrompt trực tiếp
local function triggerPrompt(obj)
    if not obj then return end
    pcall(function()
        if obj:IsA("ProximityPrompt") then
            fireproximityprompt(obj)
        else
            for _, v in ipairs(obj:GetDescendants()) do
                if v:IsA("ProximityPrompt") then
                    fireproximityprompt(v)
                end
            end
        end
    end)
end

-- TÌM PROXIMITY PROMPT / PET NÀO GẦN NHẤT CÓ THỂ CƯỚP
local function findTargetPet()
    local root = getRoot()
    if not root then return nil, nil end
    
    local bestPrompt = nil
    local bestObj = nil
    local shortestDist = math.huge
    
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local pName = prompt.ObjectText:lower() .. " " .. prompt.ActionText:lower()
            local parent = prompt.Parent
            local parentName = parent and parent.Name:lower() or ""
            
            -- Kiểm tra xem có liên quan tới Pet / Steal / Take không
            if pName:find("steal") or pName:find("take") or pName:find("pet") or pName:find("grab") or parentName:find("pet") then
                local pos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent:GetPivot().Position)
                if pos then
                    local dist = (root.Position - pos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        bestPrompt = prompt
                        bestObj = parent
                    end
                end
            end
        end
    end
    
    return bestObj, bestPrompt
end

-- TÌM TRỨNG / NÚT CHÉM TRỨNG
local function findTargetEgg()
    local root = getRoot()
    if not root then return nil, nil end
    
    local bestPrompt = nil
    local bestObj = nil
    local shortestDist = math.huge
    
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local pName = prompt.ObjectText:lower() .. " " .. prompt.ActionText:lower()
            local parent = prompt.Parent
            local parentName = parent and parent.Name:lower() or ""
            
            if pName:find("egg") or pName:find("slash") or pName:find("hatch") or pName:find("open") or parentName:find("egg") then
                local pos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent:GetPivot().Position)
                if pos then
                    local dist = (root.Position - pos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        bestPrompt = prompt
                        bestObj = parent
                    end
                end
            end
        end
    end
    
    return bestObj, bestPrompt
end

local function setHomeHere()
    local root = getRoot()
    if root then savedHome = root.Position return true end
    return false
end

local function setEndMapHere()
    local root = getRoot()
    if root then savedEndMap = root.Position return true end
    return false
end

local function getHome()
    return savedHome or (getRoot() and getRoot().Position)
end

-- VÒNG LẶP XỬ LÝ CHÍNH
task.spawn(function()
    while true do
        task.wait(0.3)
        
        -- 1. TỰ ĐỘNG BẮT PET
        if S.AutoSteal and not isBusy then
            local petObj, petPrompt = findTargetPet()
            
            if petObj and petPrompt then
                isBusy = true
                local pos = petObj:IsA("Model") and petObj:GetPivot().Position or petObj.Position
                
                print("[Kiet Hub] Phát hiện Pet! Đang di chuyển tới...")
                tweenTo(pos, S.Speed)
                task.wait(0.2)
                
                -- Kích hoạt Prompt cướp Pet
                fireproximityprompt(petPrompt)
                triggerPrompt(petObj)
                task.wait(0.4)
                
                -- Quay về Base
                if S.BringHome then
                    local home = getHome()
                    if home then
                        print("[Kiet Hub] Đã bắt Pet! Đang quay về Base...")
                        tweenTo(home, S.ReturnSpeed)
                        task.wait(0.5)
                    end
                end
                isBusy = false
            end
        end
        
        -- 2. TỰ ĐỘNG CHÉM TRỨNG
        if S.AutoSlash and not isBusy then
            if savedEndMap then
                local root = getRoot()
                if root and (root.Position - savedEndMap).Magnitude > 20 then
                    tweenTo(savedEndMap, S.Speed)
                    task.wait(0.2)
                end
            end
            
            local eggObj, eggPrompt = findTargetEgg()
            if eggObj then
                local pos = eggObj:IsA("Model") and eggObj:GetPivot().Position or eggObj.Position
                tweenTo(pos, S.Speed)
                
                if eggPrompt then
                    fireproximityprompt(eggPrompt)
                else
                    triggerPrompt(eggObj)
                end
                
                local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
            end
        end
    end
end)

