--[[
    Kiet Hub v12 - Slash and Steal Pets (Take pet từ WorldPet)
    - UI mới: 3 tab (Farm / Setup / Log), có log trạng thái
    - Steal: kiểm tra có nhận được pet (tool mới trong Backpack) hay chưa
    - Place: đặt pet về base (thử prompt có chữ place/đặt trong base của bạn)
    - Dump Info + Ghi lại thao tác: để lấy dữ liệu cách đặt pet nếu auto place chưa chạy
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local lp = Players.LocalPlayer
local playerGui = lp:WaitForChild("PlayerGui")

local oldGui = playerGui:FindFirstChild("KietSlashHub")
if oldGui then oldGui:Destroy() end
local env = (getgenv and getgenv()) or _G
if env.KietHubStop then pcall(env.KietHubStop) end

local S = {
    AutoSlash = false,
    AutoSteal = false,
    BringHome = true,
    Path = "vertical", -- vertical = dọc (Z trước) | horizontal = ngang (X trước) | straight = thẳng
    MinIncome = 20e6,
    MinEggHP = 0, -- chỉ chém egg có máu >= giá trị này (0 = chém hết)
    Speed = 55,
    ReturnSpeed = 100,
    ReturnMode = "tele", -- tele = nhảy theo bước | tween = chạy mượt
    TeleStep = 150,      -- stud mỗi lần nhảy khi tele
}

local alive = true
local savedHome, savedEndMap, startPos
local looping = false
local curTween = nil
local tried = {}
local conns = {}
local stats = { eggs = 0, pets = 0 }
local carry = { active = false, lost = false, reason = nil, uid = nil }
local moving = { tele = false, untilT = 0 }
local VERSION = "v12"

env.KietHubStop = function()
    alive = false
    S.AutoSlash, S.AutoSteal = false, false
    if curTween then pcall(function() curTween:Cancel() end) end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    local g = playerGui:FindFirstChild("KietSlashHub")
    if g then g:Destroy() end
end

----------------------------------------------------------------
-- Log / status (UI gán sau)
----------------------------------------------------------------
local logLines = {}
local logLabel, logScroll, statusLabel, statsLabel

local function log(msg)
    logLines[#logLines + 1] = os.date("%H:%M:%S ") .. tostring(msg)
    if #logLines > 120 then table.remove(logLines, 1) end
    if logLabel then
        logLabel.Text = table.concat(logLines, "\n")
        task.defer(function()
            if logScroll then logScroll.CanvasPosition = Vector2.new(0, 1e5) end
        end)
    end
end

local function setStatus(s)
    if statusLabel then statusLabel.Text = "Trạng thái: " .. s end
end

local function updateStats()
    if statsLabel then
        statsLabel.Text = ("Egg đã chém: %d  |  Pet đã lấy: %d"):format(stats.eggs, stats.pets)
    end
end

local function copyText(s)
    local f = setclipboard or toclipboard
    if f then
        local ok = pcall(f, s)
        if ok then return true end
    end
    print(s)
    return false
end

----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

local function getPos(inst)
    if not inst then return nil end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    return nil
end

local function tweenDirect(pos, speed)
    local root = getRoot()
    if not root or not pos or not alive then return end
    local dist = (root.Position - pos).Magnitude
    if dist < 8 then return end
    local t = math.max(dist / (speed or S.Speed), 0.15)
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)),
    })
    curTween = tw
    local done = false
    local c = tw.Completed:Connect(function() done = true end)
    tw:Play()
    local t0 = os.clock()
    -- chờ xong, nhưng thoát nếu nhân vật bị thay (respawn/reset) hoặc quá giờ
    while not done and alive and os.clock() - t0 < t + 1.5 do
        if getRoot() ~= root then break end
        task.wait(0.1)
    end
    c:Disconnect()
    if not done then tw:Cancel() end
    if curTween == tw then curTween = nil end
end

-- mode: "vertical" (dọc, Z trước rồi X) | "horizontal" (ngang, X trước rồi Z) | "straight"/nil (đi thẳng)
local function tweenTo(pos, speed, mode)
    local root = getRoot()
    if not root or not pos or not alive then return end
    if mode == "vertical" or mode == "horizontal" then
        local cur = root.Position
        local wp
        if mode == "vertical" then
            wp = Vector3.new(cur.X, pos.Y, pos.Z)
        else
            wp = Vector3.new(pos.X, pos.Y, cur.Z)
        end
        if (wp - cur).Magnitude > 8 and (wp - pos).Magnitude > 8 then
            tweenDirect(wp, speed)
            if not alive or (carry.active and carry.lost) then return end
        end
    end
    tweenDirect(pos, speed)
end

-- Tele theo bước: mỗi 0.05s nhảy tối đa S.TeleStep stud về phía đích (rất nhanh, boss không rượt kịp)
local function teleportTo(pos)
    if not pos or not alive then return end
    local target = pos + Vector3.new(0, 3, 0)
    moving.tele = true
    while alive do
        local root = getRoot()
        if not root then break end
        local delta = target - root.Position
        local d = delta.Magnitude
        if d <= 6 then break end
        local len = math.min(d, math.max(S.TeleStep, 20))
        root.CFrame = CFrame.new(root.Position + delta.Unit * len)
        root.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.05)
        if carry.active and carry.lost then break end
    end
    moving.tele = false
    moving.untilT = os.clock() + 0.6
end

local MULT = { k = 1e3, m = 1e6, b = 1e9, t = 1e12 }

local function parseIncome(text)
    local s = tostring(text):lower():gsub("[,%$%s]", "")
    local n, suf = s:match("^([%d%.]+)([kmbt]?)")
    n = tonumber(n)
    if not n then return 0 end
    return n * (MULT[suf] or 1)
end

local function fmtNum(n)
    if n >= 1e12 then return ("%.2fT"):format(n / 1e12) end
    if n >= 1e9 then return ("%.2fB"):format(n / 1e9) end
    if n >= 1e6 then return ("%.2fM"):format(n / 1e6) end
    if n >= 1e3 then return ("%.2fK"):format(n / 1e3) end
    return tostring(math.floor(n))
end

local function petIncome(pet)
    local best = 0
    for _, d in ipairs(pet:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text:find("/s") then
            best = math.max(best, parseIncome(d.Text))
        end
    end
    return best
end

local function asPrompt(inst)
    if inst:IsA("ProximityPrompt") then return inst end
    return inst:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function petOf(prompt)
    local m = prompt.Parent
    while m and m ~= workspace do
        if m:IsA("Model") and m:GetAttribute("SAE_PetUid") then return m end
        m = m.Parent
    end
    return nil
end

local function ancestorWithTag(inst, tag)
    local m = inst
    while m and m ~= workspace and m ~= game do
        if CollectionService:HasTag(m, tag) then return m end
        m = m.Parent
    end
    return nil
end

local function plotCenter(p)
    if p:IsA("Model") then return p:GetPivot().Position end
    if p:IsA("BasePart") then return p.Position end
    local part = p:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function attrs(inst)
    local t = {}
    for k, v in pairs(inst:GetAttributes()) do t[#t + 1] = k .. "=" .. tostring(v) end
    table.sort(t)
    return table.concat(t, ", ")
end

----------------------------------------------------------------
-- Tool tracking (pet nhận được = tool mới trong Backpack)
----------------------------------------------------------------
local function snapshotTools()
    local set = {}
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do set[t] = true end
    end
    local ch = lp.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") then set[t] = true end
        end
    end
    return set
end

local function newTool(before)
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and not before[t] then return t end
        end
    end
    local ch = lp.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") and not before[t] then return t end
        end
    end
    return nil
end

local function waitNewTool(before, timeout)
    local t0 = os.clock()
    repeat
        local t = newTool(before)
        if t then return t end
        task.wait(0.1)
    until os.clock() - t0 >= timeout
    return nil
end

----------------------------------------------------------------
-- Phát hiện bị boss đánh / mất pet khi đang mang về
----------------------------------------------------------------
local LOST_WORDS = { "stolen", "stole", "lost", "taken back", "took your", "knocked", "returned", "bị", "mất", "lấy lại" }

local function markLost(reason)
    if carry.active and not carry.lost then
        carry.lost = true
        carry.reason = reason
        log("Phát hiện bị đánh / mất pet: " .. tostring(reason))
        if curTween then curTween:Cancel() end
    end
end

local resetInfo = { at = 0 }

-- Map reset / bị ép về điểm xuất phát: huỷ tween, bỏ pet đang mang, chờ tải lại rồi chạy lại từ đầu
local function onMapReset(reason)
    if os.clock() - resetInfo.at < 5 then return end
    resetInfo.at = os.clock()
    log("Map reset / bị đưa về điểm xuất phát: " .. tostring(reason))
    setStatus("Map reset, chạy lại")
    markLost("map reset")
    if curTween then curTween:Cancel() end
    for k in pairs(tried) do tried[k] = nil end
end

local function hookCharacter(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local last = hum.Health
    conns[#conns + 1] = hum.HealthChanged:Connect(function(h)
        if h < last - 0.5 then markLost(("mất máu %.0f"):format(last - h)) end
        last = h
    end)
    conns[#conns + 1] = hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Ragdoll or new == Enum.HumanoidStateType.FallingDown
            or new == Enum.HumanoidStateType.PlatformStanding or new == Enum.HumanoidStateType.Dead then
            markLost("trạng thái " .. tostring(new))
        end
    end)
end
if lp.Character then task.spawn(hookCharacter, lp.Character) end
conns[#conns + 1] = lp.CharacterAdded:Connect(function(c)
    task.spawn(hookCharacter, c)
    if S.AutoSlash or S.AutoSteal then onMapReset("nhân vật hồi sinh") end
end)

local function startCarry(uid)
    carry.active, carry.lost, carry.reason, carry.uid = true, false, nil, uid
    task.spawn(function()
        while carry.active and alive do
            if carry.uid then
                -- egg của pet này quay lại map (boss lấy lại trứng)
                for _, m in ipairs(CollectionService:GetTagged("SAE_WorldEgg")) do
                    if m:GetAttribute("SAE_EggUid") == carry.uid
                        and m:GetAttribute("SAE_HatchState") ~= "hatched"
                        and (m:GetAttribute("SAE_EggHP") or 0) > 0 then
                        markLost("egg quay lại map")
                        break
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end

local function stopCarry()
    carry.active = false
end

-- Phát hiện bị teleport: vị trí nhảy > 120 stud trong 0.25s (tween của mình không bao giờ nhanh vậy)
task.spawn(function()
    local last
    while alive do
        local root = getRoot()
        if root then
            local pos = root.Position
            if last and (S.AutoSlash or S.AutoSteal) and not moving.tele and os.clock() > moving.untilT
                and (pos - last).Magnitude > 120 then
                onMapReset(("vị trí nhảy %d stud"):format((pos - last).Magnitude))
            end
            last = pos
        else
            last = nil
        end
        task.wait(0.25)
    end
end)

----------------------------------------------------------------
-- Take pet: egg nở thành WorldPet, prompt "TakeEgg" (Take pet, giữ 1s)
----------------------------------------------------------------
local function nowServer()
    local ok, t = pcall(function() return workspace:GetServerTimeNow() end)
    return ok and t or os.time()
end

-- onlyMine: chỉ pet do mình nở | excludeMine: chỉ pet người khác nở
local function findTakeable(onlyMine, excludeMine)
    local myId = tostring(lp.UserId)
    local seen, list = {}, {}
    local function consider(m)
        if seen[m] or not m:IsA("Model") then return end
        seen[m] = true
        if m:GetAttribute("SAE_HatchState") ~= "hatched" then return end
        local expire = m:GetAttribute("SAE_PetExpireAt")
        if type(expire) == "number" and expire - nowServer() < 3 then return end
        local prompt = m:FindFirstChild("TakeEgg", true)
        if not (prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled) then return end
        local mine = tostring(m:GetAttribute("SAE_HatchBy")) == myId
        if onlyMine and not mine then return end
        if excludeMine and mine then return end
        list[#list + 1] = { pet = m, prompt = prompt, mine = mine }
    end
    local world = workspace:FindFirstChild("SAE_World")
    if world then
        for _, m in ipairs(world:GetChildren()) do consider(m) end
    end
    for _, m in ipairs(CollectionService:GetTagged("SAE_WorldEgg")) do consider(m) end
    return list
end

local function worldPetIncome(m)
    local inc = petIncome(m)
    if inc > 0 then return inc end
    for _, k in ipairs({ "SAE_HatchIncome", "Income" }) do
        local v = m:GetAttribute(k)
        if type(v) == "number" and v > 0 then return v end
    end
    return 0
end

local function pickNearest(list, maxD)
    local root = getRoot()
    if not root then return nil end
    local best, bd = nil, maxD
    for _, it in ipairs(list) do
        local pos = getPos(it.pet)
        if pos then
            local d = (root.Position - pos).Magnitude
            if d < bd then best, bd = it, d end
        end
    end
    return best
end

local function takePet(item)
    local pet, prompt = item.pet, item.prompt
    local name = tostring(pet:GetAttribute("DisplayName") or pet.Name)
    item.uid = pet:GetAttribute("SAE_EggUid")
    setStatus("Đang lấy " .. name)
    tweenTo(getPos(pet), S.Speed + 5)

    local before = snapshotTools()
    local origHold = prompt.HoldDuration
    local function taken()
        return not prompt:IsDescendantOf(workspace) or not prompt.Enabled
            or not pet:IsDescendantOf(workspace) or newTool(before) ~= nil
    end

    -- Cách 1: fireproximityprompt
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
    end)
    for _ = 1, 2 do
        pcall(fireproximityprompt, prompt)
        local t0 = os.clock()
        repeat task.wait(0.1) until taken() or os.clock() - t0 > 0.8
        if taken() then break end
    end

    -- Cách 2: giữ prompt thật theo HoldDuration gốc (1s)
    if not taken() then
        log("fire không ăn, giữ prompt thật " .. tostring(origHold) .. "s")
        pcall(function() prompt.HoldDuration = origHold end)
        pcall(function() prompt:InputHoldBegin() end)
        task.wait(origHold + 0.2)
        pcall(function() prompt:InputHoldEnd() end)
        local t0 = os.clock()
        repeat task.wait(0.1) until taken() or os.clock() - t0 > 1.2
    end

    if taken() then
        stats.pets += 1
        updateStats()
        local tool = newTool(before)
        log("Đã lấy " .. name .. (tool and (" -> tool " .. tool.Name) or " (không có tool mới trong túi)"))
        return true, tool, before
    end
    log("Chưa lấy được " .. name)
    return false, nil, before
end

-- Lấy pet xong: chạy về điểm nhận (Home), pet sẽ tự vào túi. Vào base thì tự bấm Trang bị.
-- Nếu bị boss đánh giữa đường thì bỏ chạy về, quay lại chém tiếp.
local function afterTake(ok, tool, before, uid)
    if not ok or not S.BringHome then return end
    startCarry(uid)
    local home = savedHome or startPos
    if home then
        setStatus("Chạy về điểm nhận pet")
        if S.ReturnMode == "tele" then
            teleportTo(home)
        else
            tweenTo(home, S.ReturnSpeed, S.Path)
        end
    end
    local got = tool or newTool(before)
    if not got and not carry.lost then
        setStatus("Chờ pet vào túi")
        local t0 = os.clock()
        repeat
            got = newTool(before)
            if got or carry.lost then break end
            task.wait(0.2)
        until os.clock() - t0 > 8
    end
    local lost, reason = carry.lost, carry.reason
    stopCarry()
    if got then
        log("Pet đã vào túi: " .. got.Name)
    elseif lost then
        stats.pets = math.max(stats.pets - 1, 0)
        updateStats()
        setStatus("Bị boss, quay lại chém")
        log("Pet bị lấy lại (" .. tostring(reason) .. "), quay lại chém egg")
    else
        log("Đã về điểm nhưng chưa thấy pet vào túi. Kiểm tra lại Set Home (phải đúng điểm nhận pet).")
    end
end

-- Auto Steal = Take pet: nhặt pet vừa nở (của mình hoặc người khác) có income >= min
local skipped = {}

local function stealOnce()
    local now = os.clock()
    local best, bestInc = nil, 0
    for _, it in ipairs(findTakeable(false, false)) do
        if not (tried[it.prompt] and now - tried[it.prompt] < 8) then
            local inc = worldPetIncome(it.pet)
            if inc >= S.MinIncome then
                if inc > bestInc then best, bestInc = it, inc end
            elseif not skipped[it.pet] then
                skipped[it.pet] = true
                log(("Bỏ qua %s (%s/s < min %s/s)"):format(
                    tostring(it.pet:GetAttribute("DisplayName") or it.pet.Name),
                    fmtNum(inc), fmtNum(S.MinIncome)))
            end
        end
    end
    if not best then return false end
    tried[best.prompt] = now
    log(("Take pet: %s (%s/s)%s"):format(
        tostring(best.pet:GetAttribute("DisplayName") or best.pet.Name),
        fmtNum(bestInc), best.mine and " [của mình]" or ""))
    local ok, tool, before = takePet(best)
    afterTake(ok, tool, before, best.uid)
    return true
end

----------------------------------------------------------------
-- Slash
----------------------------------------------------------------
local function isWeapon(t)
    return t:IsA("Tool") and not t.Name:find("/s") and t.Name ~= "Trap"
end

local function equipWeapon()
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local held = char:FindFirstChildOfClass("Tool")
    if held and isWeapon(held) then return held end
    local bp = lp:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if isWeapon(t) then
                hum:EquipTool(t)
                task.wait(0.2)
                return t
            end
        end
    end
    return nil
end

local function findEgg()
    local root = getRoot()
    if not root then return nil end
    local bestNear, bestNearD = nil, math.huge
    local bestEnd, bestEndD = nil, math.huge
    for _, egg in ipairs(CollectionService:GetTagged("SAE_WorldEgg")) do
        local hp = egg:GetAttribute("SAE_EggHP")
        if type(hp) == "number" and hp > 0 and egg:IsDescendantOf(workspace) then
            local maxhp = egg:GetAttribute("SAE_EggMaxHP")
            local size = math.max(hp, type(maxhp) == "number" and maxhp or 0)
            local pos = getPos(egg)
            if pos and size >= S.MinEggHP then
                local d = (root.Position - pos).Magnitude
                if d < bestNearD then bestNear, bestNearD = egg, d end
                -- ưu tiên egg ở khu Map Cuối (bán kính 150 quanh điểm đã Set)
                if savedEndMap and (pos - savedEndMap).Magnitude <= 150 and d < bestEndD then
                    bestEnd, bestEndD = egg, d
                end
            end
        end
    end
    return bestEnd or bestNear
end

local function slashOnce()
    local root = getRoot()
    if not root then return end
    local egg = findEgg()
    if not egg then
        setStatus("Chờ egg" .. (S.MinEggHP > 0 and (" >= " .. fmtNum(S.MinEggHP) .. " máu") or ""))
        if savedEndMap and (root.Position - savedEndMap).Magnitude > 45 then
            tweenTo(savedEndMap, S.Speed)
        end
        return
    end
    local tool = equipWeapon()
    if not tool then
        setStatus("Không có vũ khí trong túi")
        return
    end
    setStatus("Đang chém egg")
    tweenTo(getPos(egg), S.Speed)
    local n = 0
    while alive and S.AutoSlash and n < 40 and getRoot()
        and egg:IsDescendantOf(workspace)
        and (egg:GetAttribute("SAE_EggHP") or 0) > 0 do
        pcall(function() tool:Activate() end)
        n += 1
        task.wait(0.15)
    end
    if not egg:IsDescendantOf(workspace) or (egg:GetAttribute("SAE_EggHP") or 0) <= 0 then
        stats.eggs += 1
        updateStats()
    end
end

----------------------------------------------------------------
-- Main loop
----------------------------------------------------------------
local function step()
    local since = os.clock() - resetInfo.at
    if since < 3 then
        task.wait(3 - since)
    end
    if not getRoot() then return end
    if S.AutoSteal and stealOnce() then return end
    if S.AutoSlash then slashOnce() end
end

local function mainLoop()
    if looping then return end
    looping = true
    local r = getRoot()
    startPos = r and r.Position or startPos
    log("Bắt đầu chạy")
    while alive and (S.AutoSlash or S.AutoSteal) do
        local ok, err = pcall(step)
        if not ok then
            warn("[Kiet Hub] " .. tostring(err))
            log("LỖI: " .. tostring(err))
        end
        task.wait(0.3)
    end
    looping = false
    setStatus("Idle")
    log("Đã dừng")
end

local function refresh()
    if S.AutoSlash or S.AutoSteal then
        task.spawn(mainLoop)
    elseif curTween then
        curTween:Cancel()
    end
end

