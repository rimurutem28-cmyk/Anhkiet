--[[
    Kiet Hub - Slash and Steal Pets
    Fix: Bắt pet lại + cố gắng lên map cuối + về base chậm
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local lp = Players.LocalPlayer
repeat task.wait() until lp

local S = {
    AutoSlash = false,
    AutoSteal = false,
    MinIncome = 20000000,
    SlashRange = 80,      -- tăng tầm tìm trứng
    StealRange = 70,
    BringHome = true,
    Speed = 65,           -- tốc độ di chuyển
    ReturnSpeed = 50,     -- về base chậm hơn
}

local savedHome = nil

local function getRoot()
    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

local function tweenTo(pos, speed)
    local root = getRoot()
    if not root or not pos then return end
    local dist = (root.Position - pos).Magnitude
    if dist < 6 then return end
    local t = math.clamp(dist / (speed or S.Speed), 0.3, 5)
    local tw = TweenService:Create(root, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 3.5, 0))
    })
    tw:Play()
    tw.Completed:Wait()
end

local function spamClick(n)
    for i = 1, (n or 8) do
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            task.wait(0.03)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end)
        task.wait(0.05)
    end
end

local function firePrompts(obj)
    if not obj then return end
    pcall(function()
        for _, v in ipairs(obj:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                fireproximityprompt(v)
            end
        end
    end)
end

-- ==================== HOME ====================
local function setHomeHere()
    local root = getRoot()
    if root then
        savedHome = root.Position
        return true
    end
    return false
end

local function getHome()
    if savedHome then return savedHome end
    local root = getRoot()
    return root and root.Position or Vector3.new(0, 10, 0)
end

-- ==================== EGG (ưu tiên xa hơn = map cuối) ====================
local function findBestEgg()
    local root = getRoot()
    if not root then return nil end

    local best, bestScore = nil, -1
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("egg") or obj:GetAttribute("Egg") or obj:HasTag("Egg") then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local dist = (root.Position - pos).Magnitude
                if dist < S.SlashRange then
                    -- Ưu tiên trứng xa hơn (thường là map cuối)
                    local score = dist
                    if score > bestScore then
                        bestScore = score
                        best = obj
                    end
                end
            end
        end
    end
    return best
end

-- ==================== PET ====================
local function parseIncome(text)
    if not text then return 0 end
    text = tostring(text):lower():gsub(",", ""):gsub("%$", ""):gsub("%s", "")
    local num, suf = text:match("([%d%.]+)([kmb]?)")
    if not num then return 0 end
    num = tonumber(num) or 0
    if suf == "k" then return num * 1e3 end
    if suf == "m" then return num * 1e6 end
    if suf == "b" then return num * 1e9 end
    return num
end

local function getIncome(obj)
    for _, a in ipairs({"Income","MoneyPerSecond","Value","MPS","Earnings","Gen","Money","CashPerSec"}) do
        local v = obj:GetAttribute(a)
        if type(v) == "number" and v > 0 then return v end
        if type(v) == "string" then
            local n = parseIncome(v)
            if n > 0 then return n end
        end
    end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local n = parseIncome(d.Text)
            if n >= 1000 then return n end
        end
    end
    return 0
end

local function findBestPet()
    local root = getRoot()
    if not root then return nil end

    local best, bestInc, bestD = nil, 0, S.StealRange
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            local inc = getIncome(obj)
            if (name:find("pet") or obj:GetAttribute("Pet") or obj:HasTag("Pet") or inc > 0) and inc >= S.MinIncome then
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                local d = (root.Position - pos).Magnitude
                if d < bestD or (inc > bestInc and d < S.StealRange * 2.5) then
                    best = obj
                    bestInc = inc
                    bestD = d
                end
            end
        end
    end
    return best
end

-- ==================== LOOPS ====================
local function autoSlashLoop()
    while S.AutoSlash do
        local egg = findBestEgg()
        if egg then
            local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
            tweenTo(pos, S.Speed)
            spamClick(14)
            firePrompts(egg)
            local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
        else
            -- Không thấy trứng gần → thử đi thẳng về phía trước (map cuối)
            local root = getRoot()
            if root then
                local forward = root.CFrame.LookVector * 40
                tweenTo(root.Position + forward, S.Speed)
            end
        end
        task.wait(0.25)
    end
end

local function autoStealLoop()
    while S.AutoSteal do
        local pet = findBestPet()
        if pet then
            local pos = pet:IsA("Model") and pet:GetPivot().Position or pet.Position
            tweenTo(pos, S.Speed + 10)
            task.wait(0.15)
            firePrompts(pet)
            spamClick(6)

            local prompt = pet:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                pcall(fireproximityprompt, prompt)
            end

            task.wait(0.4)

            -- Về base chậm
            if S.BringHome then
                local home = getHome()
                tweenTo(home, S.ReturnSpeed)
                task.wait(0.3)
                firePrompts(workspace)
            end
        end
        task.wait(0.4)
    end
end

