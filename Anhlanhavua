local function MakeButton(text, y, color, callback)

    local button = Instance.new("TextButton")

    button.Size = UDim2.new(1, -24, 0, 35)

    button.Position = UDim2.fromOffset(12, y)

    button.BackgroundColor3 = color

    button.BorderSizePixel = 0

    button.Text = text

    button.TextColor3 = Colors.White

    button.Font = Enum.Font.GothamBold

    button.TextSize = 11

    button.AutoButtonColor = true

    button.Parent = Body

    Instance.new("UICorner", button).CornerRadius =

        UDim.new(0, 9)

    button.Activated:Connect(function()

        local success, err = pcall(callback)

        if not success then

            SetStatus("Action failed")

            warn("[KietHub] Button error:", err)

        end

    end)

    return button

end

local function MakeToggle(label, y, key)

    local button = MakeButton("", y, Colors.Panel, function()

        Config[key] = not Config[key]

        SetStatus(label .. ": " ..

            (Config[key] and "ON" or "OFF"))

    end)

    local labelText = Instance.new("TextLabel")

    labelText.Size = UDim2.new(1, -65, 1, 0)

    labelText.Position = UDim2.fromOffset(12, 0)

    labelText.BackgroundTransparency = 1

    labelText.Text = label

    labelText.TextColor3 = Colors.White

    labelText.Font = Enum.Font.GothamMedium

    labelText.TextSize = 11

    labelText.TextXAlignment = Enum.TextXAlignment.Left

    labelText.Parent = button

    local stateText = Instance.new("TextLabel")

    stateText.Size = UDim2.fromOffset(43, 25)

    stateText.Position = UDim2.new(1, -51, 0.5, -12)

    stateText.BackgroundColor3 = Config[key]

        and Colors.Green or Colors.Red

    stateText.Text = Config[key] and "ON" or "OFF"

    stateText.TextColor3 = Colors.White

    stateText.Font = Enum.Font.GothamBold

    stateText.TextSize = 10

    stateText.Parent = button

    Instance.new("UICorner", stateText).CornerRadius =

        UDim.new(0, 6)

    button.Activated:Connect(function()

        stateText.Text = Config[key] and "ON" or "OFF"

        stateText.BackgroundColor3 = Config[key]

            and Colors.Green or Colors.Red

    end)

    return button

end

