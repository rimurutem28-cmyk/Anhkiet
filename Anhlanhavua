-- Main loop
----------------------------------------------------------------
local function step()
    local since = os.clock() - resetInfo.at
    if since < 3 then
        task.wait(3 - since)
    end
    if not getRoot() then return end
    if bossStep() then return end
    if S.AutoSteal and stealOnce() then return end
    if S.AutoSlash then slashOnce() end
end

local function mainLoop()
    if looping then return end
    looping = true
    local r = getRoot()
    startPos = r and r.Position or startPos
    lane.passedHome = savedHome ~= nil and r ~= nil and (r.Position - savedHome).Magnitude <= 45
    log("Bắt đầu chạy")
    while alive and (S.AutoSlash or S.AutoSteal or S.AutoBoss) do
        local ok, err = pcall(step)
        if not ok then
            warn("[Kiet Hub] " .. tostring(err))
            log("LỖI: " .. tostring(err))
        end
        task.wait(0.3)
    end
    looping = false
    setStatus("Idle")
    log("Đã dừng")
end

local function refresh()
    if S.AutoSlash or S.AutoSteal or S.AutoBoss then
        task.spawn(mainLoop)
    elseif curTween then
        curTween:Cancel()
    end
end

