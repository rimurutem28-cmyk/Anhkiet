    return pg
end

local function switchRow(parent, text, key, cb)
    local row = mk("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.panel }, parent)
    corner(row, 10)
    mk("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = C.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
    }, row)
    local track = mk("TextButton", {
        Size = UDim2.fromOffset(44, 24),
        Position = UDim2.new(1, -56, 0.5, -12),
        Text = "",
        AutoButtonColor = false,
        BackgroundColor3 = C.off,
    }, row)
    corner(track, 12)
    local knob = mk("Frame", {
        Size = UDim2.fromOffset(18, 18),
        Position = UDim2.fromOffset(3, 3),
        BackgroundColor3 = Color3.new(1, 1, 1),
    }, track)
    corner(knob, 9)
    local function paint(animate)
        local on = S[key]
        local goal = on and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3)
        if animate then
            TweenService:Create(knob, TweenInfo.new(0.15), { Position = goal }):Play()
        else
            knob.Position = goal
        end
        TweenService:Create(track, TweenInfo.new(0.15), { BackgroundColor3 = on and C.accent or C.off }):Play()
    end
    paint(false)
    track.MouseButton1Click:Connect(function()
        S[key] = not S[key]
        paint(true)
        if cb then cb() end
    end)
end

local function inputRow(parent, text, getter, setter)
    local row = mk("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.panel }, parent)
    corner(row, 10)
    mk("TextLabel", {
        Size = UDim2.new(1, -110, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = C.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
    }, row)
    local box = mk("TextBox", {
        Size = UDim2.fromOffset(84, 28),
        Position = UDim2.new(1, -94, 0.5, -14),
        BackgroundColor3 = C.panel2,
        Text = tostring(getter()),
        TextColor3 = C.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        ClearTextOnFocus = false,
    }, row)
    corner(box, 8)
    box.FocusLost:Connect(function()
        local v = tonumber(box.Text)
        if v and v >= 0 then setter(v) end
        box.Text = tostring(getter())
    end)
end

local function actionButton(parent, text, color, onClick)
    local b = mk("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = color,
        Text = text,
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
    }, parent)
    corner(b, 10)
    b.MouseButton1Click:Connect(function()
        local msg = onClick(b)
        if msg then
            b.Text = msg
            task.delay(1.4, function()
                if b.Parent then b.Text = text end
            end)
        end
    end)
    return b
end

